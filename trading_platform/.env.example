# ── Required ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Trading mode ──────────────────────────────────────────────────────
TRADING_MODE=paper                  # paper | live
REQUIRE_HUMAN_APPROVAL=true

# ── Risk limits ───────────────────────────────────────────────────────
ACCOUNT_SIZE=25000.0
MAX_POSITION_SIZE_PCT=0.05          # 5% of account per position
MAX_OPEN_POSITIONS=5
DAILY_LOSS_LIMIT_PCT=0.03           # 3% daily stop
WEEKLY_LOSS_LIMIT_PCT=0.07          # 7% weekly stop
MIN_REWARD_RISK_RATIO=1.5
MAX_IV_RANK=85.0
MIN_OPEN_INTEREST=100
MIN_VOLUME=50
MAX_BID_ASK_SPREAD_PCT=0.10

# ── Market data ───────────────────────────────────────────────────────
DEFAULT_TICKERS=SPY,QQQ,AAPL,TSLA,NVDA
DATA_LOOKBACK_DAYS=30

# ── IBKR (live trading only) ──────────────────────────────────────────
# IBKR_HOST=127.0.0.1
# IBKR_PORT=7497
# IBKR_CLIENT_ID=1

# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./trade_journal.db

# ── API ───────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false
CORS_ORIGINS=http://localhost:3000

# ── Alerts (optional) ─────────────────────────────────────────────────
# ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/...

# ── Logging ───────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=false

# ── Claude model ──────────────────────────────────────────────────────
CLAUDE_MODEL=claude-opus-4-7
