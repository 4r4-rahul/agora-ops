//@version=5
indicator("Rahul Momentum Options Engine (v4.6 trend/scalp RR + time + RTH panel)", overlay = true, max_labels_count = 500)

//────────────────────────────────────
// CORE INDICATORS
//────────────────────────────────────
vwapVal = ta.vwap(close)
emaFast = ta.ema(close, 9)
emaSlow = ta.ema(close, 21)

volMA  = ta.sma(volume, 20)
body   = math.abs(close - open)
bodyMA = ta.sma(body, 20)

atr14  = ta.atr(14)
rsi14  = ta.rsi(close, 14)
[diPlus, diMinus, adx14] = ta.dmi(14, 14)  // ADX for trend strength / chop detection

// Distance from VWAP in ATR units
distFromVWAPATR       = math.abs(close - vwapVal) / atr14
nearVWAPEntry         = distFromVWAPATR <= 0.6
farFromVWAPEntry      = distFromVWAPATR >= 1.0
extendedFromVWAPEntry = distFromVWAPATR > 1.2  // very extended, fade risk

//────────────────────────────────────
// VISUAL / BEHAVIOR INPUTS
//────────────────────────────────────
entryLabelMult  = input.float(1.2, "Entry label distance (ATR)", minval = 0.5, step = 0.1)
exitLabelMult   = input.float(1.8, "Exit label distance (ATR)",  minval = 0.5, step = 0.1)
bannerAtrMult   = input.float(2.5, "Banner distance (ATR)",      minval = 1.0, step = 0.1)

showTinyMarks   = input.bool(true,  "Show tiny markers on candles")
useLunchFilter  = input.bool(true,  "Use no-trade zone (lunch)")
showRegimeBg    = input.bool(false, "Show regime background")

htfTF        = input.timeframe("5", "HTF timeframe for regime")
dxySymbol    = input.symbol("DXY",   "Dollar index symbol (DXY)")
us10ySymbol  = input.symbol("US10Y", "10Y yield symbol")
LunchSession = input.session("1130-1300", "No-trade session (exchange time)")
AfternoonTrendSession = input.session("1300-1600", "Trend re-arm session (exchange time)")
RTHSession   = input.session("0930-1600", "RTH session (exchange time)")

// Stop / target config for lines
riskATRMult   = input.float(1.0, "Base stop distance (ATR multiples)", minval = 0.1, step = 0.1)
rrMultTrend   = input.float(2.0, "Target R multiple – TREND", minval = 0.5, step = 0.5)
rrMultScalp   = input.float(1.0, "Target R multiple – SCALP", minval = 0.2, step = 0.1)

// Time stops
maxBarsInTradeTrend = input.int(15, "Max bars in trade – TREND", minval = 1, maxval = 100)
maxBarsInTradeScalp = input.int(8,  "Max bars in trade – SCALP", minval = 1, maxval = 100)

// Dynamic $-R + contract helper
acctEquity      = input.float(2000, "Account equity ($)", minval = 100)
riskPctPerTrade = input.float(1.0,  "Risk per trade (% of equity)", minval = 0.1, maxval = 5.0)
showSizeHelper  = input.bool(true,  "Show 1R $ & contract size guide")

// Micro-chop filter & vol-adjust
useChopFilter = input.bool(true,  "Use micro-chop filter")
useVolAdjust  = input.bool(true,  "Auto-adjust risk by volatility")

// VWAP mean-reversion scalps (aggressive, hints only)
enableScalpHints = input.bool(false, "Show VWAP mean-reversion scalp hints (aggressive)")

// Stats dashboard
statsLookback  = input.int(20, "Stats lookback (RTH trades)", minval = 5, maxval = 100)
showStatsTable = input.bool(true, "Show stats dashboard (RTH)")

//────────────────────────────────────
// MOMENTUM EXTENSION LOGIC (CALL / PUT)
//────────────────────────────────────

// VWAP slope
vwapUp   = vwapVal > vwapVal[1]
vwapDown = vwapVal < vwapVal[1]

// Micro-chop: price hugging VWAP & EMAs tight
emaSpread   = math.abs(emaFast - emaSlow)
microChop   = distFromVWAPATR < 0.1 and emaSpread < atr14 * 0.03  // Tightened to only block extreme chop

// ADX-based chop/range filter (ADX < 15 = no directional trend, stay out)
isChopping  = adx14 < 15.0  // Further relaxed from 20 to 15
allowTrade  = not useChopFilter or (not microChop and not isChopping)

// Bull momentum (CALL)
bullMomentum =
     close   > vwapVal and
     emaFast > emaSlow and
     vwapUp  and
     body    > bodyMA and
     volume  > volMA and
     allowTrade

// Bear momentum (PUT)
bearMomentum =
     close   < vwapVal and
     emaFast < emaSlow and
     vwapDown and
     body    > bodyMA and
     volume  > volMA and
     allowTrade

//────────────────────────────────────
// REGIME DETECTION: TREND VS GRIND
//────────────────────────────────────

// RSI structure
rsiDirectional = rsi14 >= 60 or rsi14 <= 40
rsiCenterish   = rsi14 > 45 and rsi14 < 55

// HTF trend (on same symbol)
htfClose  = request.security(syminfo.tickerid, htfTF, close)
htfEMA20  = request.security(syminfo.tickerid, htfTF, ta.ema(close, 20))
htfUp     = htfClose > htfEMA20
htfDown   = htfClose < htfEMA20

isTrendRegime   = farFromVWAPEntry and rsiDirectional and (htfUp or htfDown)
isGrindRegime   = nearVWAPEntry and rsiCenterish and not isTrendRegime
isNeutralRegime = not isTrendRegime and not isGrindRegime

// slow grind trend / bleeder day flag
isBleedTrend = isTrendRegime and distFromVWAPATR < 0.8 and emaSpread < atr14 * 0.15

// Optional background shading
regimeColor =
     isTrendRegime   ? color.new(color.green,  85) :
     isGrindRegime   ? color.new(color.orange, 88) :
     isNeutralRegime ? color.new(color.gray,   90) :
                       na

bgcolor(showRegimeBg ? regimeColor : na)

//────────────────────────────────────
// MACRO WIND (DXY + 10Y)
//────────────────────────────────────
dxyClose = request.security(dxySymbol, "60", close)
dxyMA20  = request.security(dxySymbol, "60", ta.sma(close, 20))
usdUp    = dxyClose > dxyMA20

us10yClose = request.security(us10ySymbol, "60", close)
us10yMA20  = request.security(us10ySymbol, "60", ta.sma(close, 20))
yieldsUp   = us10yClose > us10yMA20

macroBullMetals = (not usdUp) and (not yieldsUp)        // good for GLD/SLV
macroBearMetals = usdUp and yieldsUp                    // headwind
macroNeutral    = not macroBullMetals and not macroBearMetals

//────────────────────────────────────
// VOLATILITY REGIME & RISK ADJUST
//────────────────────────────────────
dayATR   = request.security(syminfo.tickerid, "D", ta.atr(14))
dayClose = request.security(syminfo.tickerid, "D", close)
volPct   = dayClose > 0 ? (dayATR / dayClose) * 100.0 : 0.0

volHigh = volPct > 3.0
volLow  = volPct < 1.5

volAdjMult =
     not useVolAdjust ? 1.0 :
     volHigh          ? 0.8 :   // tighter risk when vol high
     volLow           ? 1.2 :   // slightly wider risk when vol low
                           1.0

effRiskATRMult = riskATRMult * volAdjMult

//────────────────────────────────────
// POSITION & CAMPAIGN STATE
//────────────────────────────────────
var bool inCall = false
var bool inPut  = false

// Campaign state (all sessions)
var float dayPnL_R    = 0.0
var int   tradesToday = 0

// Idea / campaign phases
var int ideaState        = 0
int     ideaStateProbe     = 0
int     ideaStateCore      = 1
int     ideaStateExpansion = 2
int     ideaStateOff       = -1

// Last-trade info for R-multiples
var float lastEntryPrice = na
var float lastRiskATR    = na   // 1R distance in price (already ATR-scaled)
var int   lastDirection  = 0    // +1 = CALL, -1 = PUT

// Per-trade progression helpers
var bool tp1Triggered      = false
var bool tp2Triggered      = false
var bool timeStopTriggered = false
var int  barsSinceEntry    = na

// Stop/target lines for *current* trade
var line  stopLine        = na
var line  targetLine      = na
var float currStopPrice   = na
var float currTargetPrice = na

// Trade mode for *current* live position
var bool lastTradeWasScalp = false
var int  maxBarsThisTrade  = na

// Stats: store last N RTH trade R's
var float[] tradeRsRTH = array.new_float()

// Dynamic dollar risk per trade
perTradeRiskDollar = acctEquity * riskPctPerTrade / 100.0

// RTH tracking (per day)
var float todayR_RTH      = 0.0
var int   tradesTodayRTH  = 0

// Loss tracking
var int   consecutiveLosses = 0
var float lastTradeR        = 0.0

// Swing trade tracking (limit high-quality swings)
var int swingTradesToday = 0

// Trade cooldown tracking (prevent rapid re-entry)
var int lastExitBar = na
int minBarsBetweenTrades = 3  // Reduced to 3-bar cooldown

// Reset state at new daily session
if ta.change(time("D")) != 0
    inCall         := false
    inPut          := false
    dayPnL_R       := 0.0
    tradesToday    := 0
    ideaState      := ideaStateProbe
    lastEntryPrice := na
    lastRiskATR    := na
    lastDirection  := 0
    tp1Triggered   := false
    tp2Triggered   := false
    timeStopTriggered := false
    barsSinceEntry := na

    // keep lines history
    stopLine        := na
    targetLine      := na
    currStopPrice   := na
    currTargetPrice := na

    // reset today-only RTH stats
    todayR_RTH     := 0.0
    tradesTodayRTH := 0
    
    // reset loss tracking
    consecutiveLosses := 0
    lastTradeR        := 0.0
    swingTradesToday  := 0
    
    // reset cooldown
    lastExitBar := na

// Sessions
inLunchSession           = time(timeframe.period, LunchSession) != 0
noTradeZone              = useLunchFilter and inLunchSession
inAfternoonTrendSession  = time(timeframe.period, AfternoonTrendSession) != 0
inRTH                    = time(timeframe.period, RTHSession) != 0

// Opening Range (first 30 min) - critical for 0DTE direction
var float orHigh = na
var float orLow  = na
var bool orComplete = false
inOpeningRange = time(timeframe.period, "0930-1000") != 0

// Day Trend Bias (first 45 min + OR breakdown establishes the day's direction)
var float dayTrendOpen = na
var float dayTrend45MinPrice = na
var int dayTrendBias = 0  // +1 = CALL day, -1 = PUT day, 0 = neutral
var bool dayTrendSet = false
inFirst45Min = time(timeframe.period, "0930-1015") != 0  // Shortened to 45 min

if ta.change(time("D")) != 0
    orHigh := na
    orLow  := na
    orComplete := false
    dayTrendOpen := na
    dayTrend45MinPrice := na
    dayTrendBias := 0
    dayTrendSet := false

if inOpeningRange
    orHigh := na(orHigh) ? high : math.max(orHigh, high)
    orLow  := na(orLow)  ? low  : math.min(orLow, low)
    if na(dayTrendOpen)
        dayTrendOpen := open  // Capture day's opening price
else if not orComplete and not na(orHigh)
    orComplete := true

// Opening Range Breakout detection (high-probability setup)
orBreakoutBull = orComplete and close > orHigh and close[1] <= orHigh
orBreakdownBear = orComplete and close < orLow and close[1] >= orLow

// EARLY PUT/CALL day detection: Opening Range breakdown/breakout = immediate bias
if orComplete and not dayTrendSet
    if orBreakdownBear and emaFast < emaSlow  // OR breakdown + bearish structure
        dayTrendBias := -1  // Immediate PUT day
        dayTrendSet := true
    else if orBreakoutBull and emaFast > emaSlow  // OR breakout + bullish structure
        dayTrendBias := 1   // Immediate CALL day
        dayTrendSet := true

// Establish day trend bias after first 45 minutes (if not set by OR)
if inFirst45Min and not na(dayTrendOpen)
    dayTrend45MinPrice := close
else if not dayTrendSet and not na(dayTrend45MinPrice) and not inFirst45Min
    // Compare current price to opening: if down 0.2%+ = PUT day, up 0.2%+ = CALL day
    float dayMove = (dayTrend45MinPrice - dayTrendOpen) / dayTrendOpen * 100.0
    if dayMove < -0.2  // Down 0.2% or more = PUT day (relaxed from 0.3%)
        dayTrendBias := -1
    else if dayMove > 0.2  // Up 0.2% or more = CALL day (relaxed from 0.3%)
        dayTrendBias := 1
    else
        dayTrendBias := 0  // Neutral/ranging day
    dayTrendSet := true

// Wider stops on trend days - apply after dayTrendBias is established
float trendDayStopMult = (dayTrendBias != 0) ? 1.3 : 1.0  // 1.3x ATR on trend days vs 1.0x normal (reduced from 2.0x)
effRiskATRMult := riskATRMult * volAdjMult * trendDayStopMult

// DYNAMIC TREND REVERSAL DETECTION - PEAK/TROUGH BASED (checks EVERY bar)
// Detects when price drops from peak or rallies from trough - LEADING indicator
// CRITICAL for catching trend reversals the moment they happen
var float recentHigh = na
var float recentLow = na
var int barsTracked = 0

// Track recent 20-bar high/low as potential reversal points
if barstate.isnew
    barsTracked += 1
    if barsTracked >= 20 or na(recentHigh)
        recentHigh := ta.highest(high, 20)
        recentLow := ta.lowest(low, 20)
        barsTracked := 0
    else
        recentHigh := math.max(recentHigh, high)
        recentLow := math.min(recentLow, low)

// Calculate % drop from peak or rally from trough
float dropFromPeak = not na(recentHigh) and recentHigh > 0 ? (recentHigh - close) / recentHigh * 100.0 : 0.0
float rallyFromTrough = not na(recentLow) and recentLow > 0 ? (close - recentLow) / recentLow * 100.0 : 0.0

// BEARISH REVERSAL: Price dropped 0.4%+ from recent peak while on CALL day
bool peakReversal = dayTrendBias == 1 and           // Currently CALL day
     dropFromPeak >= 0.4 and                        // Dropped 0.4% from peak
     close < vwapVal and                            // Below VWAP (structure broken)
     emaFast < emaSlow                              // EMAs confirming

// BULLISH REVERSAL: Price rallied 0.4%+ from recent trough while on PUT day
bool troughReversal = dayTrendBias == -1 and       // Currently PUT day
     rallyFromTrough >= 0.4 and                    // Rallied 0.4% from trough
     close > vwapVal and                            // Above VWAP (structure broken)
     emaFast > emaSlow                              // EMAs confirming

// Also allow NEUTRAL to flip to trend if conditions met
bool neutralToBearish = dayTrendBias == 0 and      // Currently neutral
     close < vwapVal and emaFast < emaSlow and
     close < close[5] and low < low[3]

bool neutralToBullish = dayTrendBias == 0 and      // Currently neutral
     close > vwapVal and emaFast > emaSlow and
     close > close[5] and high > high[3]

// Apply reversals immediately (checked every bar, not every 5 bars)
if dayTrendSet
    if peakReversal or neutralToBearish
        dayTrendBias := -1  // Flip to PUT day
    else if troughReversal or neutralToBullish
        dayTrendBias := 1   // Flip to CALL day

// Previous Day High/Low - major institutional levels
prevDayHigh = request.security(syminfo.tickerid, "D", high[1], barmerge.gaps_off, barmerge.lookahead_on)
prevDayLow  = request.security(syminfo.tickerid, "D", low[1], barmerge.gaps_off, barmerge.lookahead_on)

// Time of day context
currentHour = hour(time)
firstHour = currentHour >= 9 and currentHour < 10
midDay = currentHour >= 11 and currentHour < 14
powerHour = currentHour >= 15 and currentHour < 16

// Quality time zones: avoid lunch chop only, allow full morning/afternoon sessions
qualityTimeZone = (currentHour >= 9 and currentHour < 16)  // Full trading day
avoidChopZone = currentHour >= 11 and currentHour < 13  // Mid-day chop zone (advisory)

// Trade cooldown check (prevent rapid re-entry after exit)
// COMPLETELY DISABLE cooldown on trending days - catch every swing including re-entries
barsInCooldown = not na(lastExitBar) ? bar_index - lastExitBar : 999
outOfCooldown = (dayTrendBias != 0) or na(lastExitBar) or barsInCooldown >= minBarsBetweenTrades  // No cooldown on trend days

//────────────────────────────────────
// CAMPAIGN GUARDRAILS
//────────────────────────────────────
maxTradesForStateBase =
     ideaState == ideaStateProbe     ? 3 :   // Reduced back to 3
     ideaState == ideaStateCore      ? 5 :   // Reduced from 10
     ideaState == ideaStateExpansion ? 8 :   // Reduced from 15
                                       0

// Allow a limited number of *extra* trades in afternoon if Trend regime returns
extraTrendTrades = (isTrendRegime and inAfternoonTrendSession and dayPnL_R > -2.0) ? 2 : 0  // Reduced from 3
maxTradesDynamic = maxTradesForStateBase + extraTrendTrades

hardStopHit   = dayPnL_R <= -4.0  // Increased from -2.0 to -4.0

// MACRO VETO: context only, not a blocker
isMetalsSymbol = syminfo.ticker == "GLD" or syminfo.ticker == "SLV" or syminfo.ticker == "GOLD" or syminfo.ticker == "SILVER"
macroVeto = false  // Disabled - macro is context, not blocker

// Sequential loss brake: track but don't block
sequentialLossBrake = false  // Disabled - track losses for stats only

// Daily swing cap: track for stats but don't block
swingCapHit = false  // Disabled - track swing count but don't limit

canTradeToday = (ideaState != ideaStateOff) and not hardStopHit and (tradesToday < maxTradesDynamic)

// HTF trend alignment requirement (5min must agree with trade direction)
// Advisory for breakouts, required for reversals/continuations
htfAllowsLong  = htfUp   // 5min trend must be up for CALL entries
htfAllowsShort = htfDown // 5min trend must be down for PUT entries
htfNeutralOrUp = not htfDown // Allow CALLs if 5min not clearly bearish
htfNeutralOrDown = not htfUp // Allow PUTs if 5min not clearly bullish

// Simplified base entry readiness with BALANCED filters
// Strong setups (BREAKOUT/BREAKDOWN) get some leniency, weak setups (REVERSAL) stay strict
baseLongReady  = not inCall and not inPut and not noTradeZone and canTradeToday and allowTrade and 
                 outOfCooldown and qualityTimeZone
                 
baseShortReady = not inPut and not inCall and not noTradeZone and canTradeToday and allowTrade and 
                 outOfCooldown and qualityTimeZone

//────────────────────────────────────
// CONFIDENCE METER (1–5) & DAY BIAS
//────────────────────────────────────
var float confidence = 0.0

confidence := 0.0
confidence += body   > bodyMA * 1.2                 ? 1.0 : 0.0  // Relaxed from 1.3x to 1.2x
confidence += volume > volMA * 1.5                  ? 1.0 : 0.0  // Strong volume required
confidence += math.abs(emaFast - emaSlow) > atr14 * 0.4 ? 1.0 : 0.0  // Wide EMA spread required
confidence += (vwapUp or vwapDown)                  ? 1.0 : 0.0
confidence += (rsi14 > 60 or rsi14 < 40)            ? 1.0 : 0.0  // Strong RSI directional
confidence := math.min(confidence, 5.0)

// Day bias: use established trend bias if set, otherwise current structure
int dayBias = 0
if dayTrendSet and dayTrendBias != 0
    dayBias := dayTrendBias  // Use established day trend
else
    // Fallback to current structure if trend not yet established
    dayBias := emaFast > emaSlow and close > vwapVal ? 1 :
               emaFast < emaSlow and close < vwapVal ? -1 :
                                                       0

//────────────────────────────────────
// MICRO STRUCTURE: pivot highs / lows
//────────────────────────────────────
pivotHigh = high[1] > high[2] and high[1] > high
pivotLow  = low[1]  < low[2]  and low[1]  < low

//────────────────────────────────────
// SWING POINT DETECTION (for high-quality entries)
//────────────────────────────────────
// Simpler swing confirmation: pivot + volume + momentum shift
// Swing low: pivot low + bounce with volume
swingLowConfirmed = pivotLow[1] and 
     close > low[1] and
     volume > volMA * 1.15

// Swing high: pivot high + rejection with volume
swingHighConfirmed = pivotHigh[1] and 
     close < high[1] and
     volume > volMA * 1.15

// VWAP rejection (price tries to break through but fails)
vwapRejectionFromAbove = high > vwapVal and close < vwapVal and close < open and volume > volMA * 1.3
vwapRejectionFromBelow = low < vwapVal and close > vwapVal and close > open and volume > volMA * 1.3

// VWAP breakout with momentum continuation
vwapBreakoutBull = close[1] <= vwapVal and close > vwapVal and body > bodyMA * 1.2 and volume > volMA * 1.5
vwapBreakoutBear = close[1] >= vwapVal and close < vwapVal and body > bodyMA * 1.2 and volume > volMA * 1.5

// Volume surge (potential turning point)
volumeSurge = volume > volMA * 1.5  // Need strong volume confirmation

// Relative Volume Strength - is volume INCREASING through the move? (strength indicator)
volumeIncreasing = volume > volume[1] and volume[1] > volume[2]
volumeStrong = volumeSurge and volumeIncreasing

// Multi-timeframe EMA confluence (all timeframes aligned = high probability)
htf15Close = request.security(syminfo.tickerid, "15", close)
htf15EMA9  = request.security(syminfo.tickerid, "15", ta.ema(close, 9))
htf15EMA21 = request.security(syminfo.tickerid, "15", ta.ema(close, 21))

mtfBullish = close > emaFast and emaFast > emaSlow and htf15Close > htf15EMA9 and htf15EMA9 > htf15EMA21
mtfBearish = close < emaFast and emaFast < emaSlow and htf15Close < htf15EMA9 and htf15EMA9 < htf15EMA21

// Expected move in dollars (for options viability check)
expectedMoveDollars = atr14 * 100.0  // ATR converted to dollars
minScalpMoveDollars = 1.0  // Lowered to $1.00 to catch more opportunities
minSwingMoveDollars = 1.0  // Lowered to $1.00 to catch more opportunities

//────────────────────────────────────
// TRADE MODES (OPTIONS-SPECIFIC LOGIC)
//────────────────────────────────────
// Options need ACCELERATION + MAGNITUDE, not just direction
// Trade BOTH sides of swings: CALLs on acceleration up, PUTs on acceleration down
// Exit FAST when momentum stalls (theta decay is brutal)

// Acceleration detection (price velocity increasing)
priceChange3 = close - close[3]
priceChange6 = close - close[6]
isAccelerating = math.abs(priceChange3) > math.abs(priceChange6) * 1.15  // Relaxed from 1.3 to 1.15

// Volatility expansion (not compression)
volExpanding = volume > volMA * 1.3 and body > bodyMA * 1.2

// MODE 1: BREAKOUT (high probability CALLs)
// Price breaks resistance + QUALITY GATES to avoid chop
// MORE AGGRESSIVE on confirmed CALL days (day trend bias)
breakoutLongBase = close > high[1] and close > high[2] and
     emaFast > emaSlow and                    // EMA alignment required
     body > bodyMA * 0.6 and                  // Very relaxed body on CALL days
     volume > volMA * 1.2 and                 // Lower volume requirement
     confidence >= (dayTrendBias == 1 ? 1 : 3) and  // VERY easy confidence on CALL days (1/5)
     (dayTrendBias == 1 or htfNeutralOrUp) and      // HTF check only if not CALL day
     expectedMoveDollars >= 1.0 and
     not extendedFromVWAPEntry                // Not too far from VWAP (fade risk)

// Opening Range Breakout (premium setup)
breakoutLongOR = orBreakoutBull and
     emaFast > emaSlow and
     volumeStrong and                          // Volume increasing
     confidence >= 3                            // Relaxed to 3/5

// Combine regular + OR breakouts (NOT reassign!)
breakoutLong = breakoutLongBase or breakoutLongOR

// BULL MOMENTUM CALL (on confirmed CALL days only - ULTRA AGGRESSIVE)
// On CALL days: ANY green candle in bullish structure = CALL entry
bullMomentumCall = dayTrendBias == 1 and  // Only on CALL days
     close > open and                      // Green candle
     close > emaFast and                   // Above fast EMA
     emaFast > emaSlow and                 // Bullish structure
     close > vwapVal and                   // Above VWAP
     not (inCall and barsSinceEntry < 2)   // Minimal cooldown (2 bars, reduced from 3)

// CONTINUOUS UPTREND CALL (long trend CALL - ride the wave up)
// Price making higher highs in sustained uptrend = keep taking CALLs
// NO COOLDOWN - catch every single qualifying candle
continuousUptrendCall = dayTrendBias == 1 and  // Only on CALL days
     close > close[3] and                       // Higher than 3 bars ago
     high > high[2] and                         // Making higher highs
     emaFast > emaSlow and                      // Bullish structure maintained
     close > vwapVal                            // Above VWAP
     // NO POSITION CHECK AT ALL - pure trend following

// SWING LOW REJECTION CALL (on confirmed CALL days only)
// Price dips to support, gets bought = HIGH PROBABILITY CALL
swingLowRejectionCall = dayTrendBias == 1 and  // Only on CALL days
     close > open and                            // Bounce candle (green)
     low[1] < low[2] and                         // Previous bar was a dip low
     body > bodyMA * 0.5 and                     // Relaxed body (reduced from 0.6)
     volume > volMA * 1.1 and                    // Lower volume requirement (reduced from 1.2)
     emaFast > emaSlow and                       // Bullish structure
     not (inCall and barsSinceEntry < 2)         // Minimal cooldown (2 bars, reduced from 3)

// MODE 2: BREAKDOWN (high probability PUTs)  
// Price breaks support + QUALITY GATES to avoid chop
// MORE AGGRESSIVE on confirmed PUT days (day trend bias)
breakdownShortBase = close < low[1] and close < low[2] and
     emaFast < emaSlow and                    // EMA alignment required
     body > bodyMA * 0.6 and                  // Very relaxed body on PUT days
     volume > volMA * 1.2 and                 // Lower volume requirement
     confidence >= (dayTrendBias == -1 ? 1 : 3) and  // VERY easy confidence on PUT days (1/5)
     (dayTrendBias == -1 or htfNeutralOrDown) and    // HTF check only if not PUT day
     expectedMoveDollars >= 1.0 and
     not extendedFromVWAPEntry                // Not too far from VWAP (fade risk)

// Opening Range Breakdown (premium setup)
breakdownShortOR = orBreakdownBear and
     emaFast < emaSlow and
     volumeStrong and                          // Volume increasing
     confidence >= 3                            // Relaxed to 3/5

// Combine regular + OR breakdowns (NOT reassign!)
breakdownShort = breakdownShortBase or breakdownShortOR

// BEAR MOMENTUM PUT (on confirmed PUT days only - ULTRA AGGRESSIVE)
// On PUT days: ANY red candle in bearish structure = PUT entry
bearMomentumPut = dayTrendBias == -1 and  // Only on PUT days
     close < open and                      // Red candle
     close < emaFast and                   // Below fast EMA
     emaFast < emaSlow and                 // Bearish structure
     close < vwapVal and                   // Below VWAP
     not (inPut and barsSinceEntry < 2)    // Minimal cooldown (2 bars, reduced from 3)

// CONTINUOUS DOWNTREND PUT (long trend PUT - ride the wave down)
// Price making lower lows in sustained downtrend = keep taking PUTs
// NO COOLDOWN - catch every single qualifying candle
continuousDowntrendPut = dayTrendBias == -1 and  // Only on PUT days
     close < close[3] and                         // Lower than 3 bars ago
     low < low[2] and                             // Making lower lows
     emaFast < emaSlow and                        // Bearish structure maintained
     close < vwapVal                              // Below VWAP
     // NO POSITION CHECK AT ALL - pure trend following

// SWING HIGH REJECTION PUT (on confirmed PUT days only)
// Price bounces to resistance, gets rejected = HIGH PROBABILITY PUT
swingHighRejectionPut = dayTrendBias == -1 and  // Only on PUT days
     close < open and                             // Rejection candle (red)
     high[1] > high[2] and                        // Previous bar was a bounce high
     body > bodyMA * 0.5 and                      // Relaxed body (reduced from 0.6)
     volume > volMA * 1.1 and                     // Lower volume requirement (reduced from 1.2)
     emaFast < emaSlow and                        // Bearish structure
     not (inPut and barsSinceEntry < 2)           // Minimal cooldown (2 bars, reduced from 3)

// MODE 3: REVERSAL from exhaustion (CALLs at bottoms, PUTs at tops)
// Capitulation volume + opposite momentum appears + EXTREME exhaustion only
// REVERSAL LONG: More aggressive on CALL days - catch swing low bounces
reversalLong = swingLowConfirmed and
     (dayTrendBias == 1 ? rsi14 < 55 : rsi14 < 30) and  // Much easier RSI on CALL days
     confidence >= (dayTrendBias == 1 ? 2 : 4) and      // Easier confidence on CALL days (2/5)
     (dayTrendBias == 1 or htfNeutralOrUp) and          // HTF check only if not CALL day
     expectedMoveDollars >= 1.0

// REVERSAL SHORT: More aggressive on PUT days - catch swing high rejections
reversalShort = swingHighConfirmed and
     (dayTrendBias == -1 ? rsi14 > 45 : rsi14 > 70) and  // Much easier RSI on PUT days
     confidence >= (dayTrendBias == -1 ? 2 : 4) and      // Easier confidence on PUT days (2/5)
     (dayTrendBias == -1 or htfNeutralOrDown) and        // HTF check only if not PUT day
     expectedMoveDollars >= 1.0

// MODE 4: CONTINUATION (join existing move on pullback)
// Pullback to VWAP → resume with volume confirmation + QUALITY GATES
continuationLong = 
     vwapBreakoutBull and
     emaFast > emaSlow and
     confidence >= 3 and                       // Relaxed to 3/5
     htfAllowsLong and                         // HTF must agree
     expectedMoveDollars >= 1.0

continuationShort = 
     vwapBreakoutBear and
     emaFast < emaSlow and
     confidence >= 3 and                       // Relaxed to 3/5
     htfAllowsShort and                        // HTF must agree
     expectedMoveDollars >= 1.0

// Classify trade type for labeling
bool isSwingTrade = false
bool isScalpTrade = false
string tradeType = "CONTINUATION"

// CALL entries: breakout, reversal, swing low rejection, bull momentum, continuous uptrend, or continuation UP
callSetup = breakoutLong or reversalLong or swingLowRejectionCall or bullMomentumCall or continuousUptrendCall or continuationLong
if callSetup
    tradeType := breakoutLong ? "BREAKOUT" : 
                 (reversalLong ? "REVERSAL" : 
                 (swingLowRejectionCall ? "SWING REJECTION" : 
                 (bullMomentumCall ? "BULL MOMENTUM" : 
                 (continuousUptrendCall ? "LONG TREND CALL" : "CONTINUATION"))))
    isSwingTrade := breakoutLong or reversalLong or swingLowRejectionCall or continuousUptrendCall  // Trend CALLs are swings
    isScalpTrade := (continuationLong or bullMomentumCall) and not isSwingTrade  // continuation/momentum are scalp-like

// PUT entries: breakdown, reversal, swing high rejection, bear momentum, continuous downtrend, or continuation DOWN  
putSetup = breakdownShort or reversalShort or swingHighRejectionPut or bearMomentumPut or continuousDowntrendPut or continuationShort
if putSetup
    tradeType := breakdownShort ? "BREAKDOWN" : 
                 (reversalShort ? "REVERSAL" : 
                 (swingHighRejectionPut ? "SWING REJECTION" : 
                 (bearMomentumPut ? "BEAR MOMENTUM" : 
                 (continuousDowntrendPut ? "LONG TREND PUT" : "CONTINUATION"))))
    isSwingTrade := breakdownShort or reversalShort or swingHighRejectionPut or continuousDowntrendPut  // Trend PUTs are swings
    isScalpTrade := (continuationShort or bearMomentumPut) and not isSwingTrade  // continuation/momentum are scalp-like

// Entry logic: allow ANY quality setup based on price action
// Options traders take BOTH sides based on acceleration direction
// EXCEPTION: On PUT days, block CALLs entirely. On CALL days, block PUTs entirely.
buyCall = baseLongReady and callSetup and (dayTrendBias != -1)  // Block CALLs on PUT days
buyPut  = baseShortReady and putSetup and (dayTrendBias != 1)   // Block PUTs on CALL days

// Mark swing trades and increment counter
if (buyCall and (breakoutLong or reversalLong)) or (buyPut and (breakdownShort or reversalShort))
    isSwingTrade := true
    swingTradesToday += 1

// Calculate current R for use in exit logic
float currentR = na
if (inCall or inPut) and not na(lastEntryPrice) and lastRiskATR > 0
    float move       = close - lastEntryPrice
    float signedMove = lastDirection == +1 ? move : -move
    currentR := signedMove / lastRiskATR

// OPTIONS-SPECIFIC EXIT LOGIC
// Exit FAST when momentum stalls - theta decay kills you
// Don't hope for recovery - options are not stocks

// Momentum stalling detection - very relaxed to hold through consolidations
// On trend days, we want to HOLD through pauses, not exit immediately
momentumStalling = math.abs(close - close[3]) < atr14 * 0.4  // Tightened - only exit if REALLY stalled
momentumReversing = math.abs(close - close[5]) < atr14 * 0.3  // Even tighter for confirmed stall

// HARD STOP LOSS CHECK (CRITICAL - prevents disasters)
// Force exit if price crosses stop line
bool hardStopHitCall = inCall and not na(currStopPrice) and low <= currStopPrice
bool hardStopHitPut = inPut and not na(currStopPrice) and high >= currStopPrice

// WRONG SIDE DETECTION (in PUT but price rallying hard, or in CALL but price dumping)
// If trade is clearly wrong direction, exit immediately
// ONLY APPLY ON NEUTRAL DAYS - trend days have normal volatility
bool wrongSideCall = dayTrendBias == 0 and inCall and (
     close < emaSlow and emaFast < emaSlow and close < vwapVal and  // Clear downtrend structure
     low < low[1] and low[1] < low[2])  // Making lower lows

bool wrongSidePut = dayTrendBias == 0 and inPut and (
     close > emaSlow and emaFast > emaSlow and close > vwapVal and  // Clear uptrend structure
     high > high[1] and high[1] > high[2])  // Making higher highs

// MAX LOSS CAP - never let a trade lose more than -1.5R (safety net)
bool maxLossCapCall = inCall and not na(currentR) and currentR <= -1.5
bool maxLossCapPut = inPut and not na(currentR) and currentR <= -1.5

// TREND DAY vs NEUTRAL DAY exit logic (CRITICAL FIX)
// On trend days: HOLD through consolidations, only exit on confirmed reversal
// On neutral days: Exit fast on momentum stall

// CALL exits
bool callTrendDayExit = dayTrendBias == 1 and inCall and (
     // Only exit on STRONG CONFIRMED reversal on CALL days - very high bar
     (emaFast < emaSlow and close < vwapVal and volume > volMA * 1.5 and body > bodyMA * 1.5) or  // Strong reversal with conviction
     (close < emaSlow and body > bodyMA * 1.8 and volume > volMA * 1.5))  // Very clear breakdown

bool callNeutralDayExit = dayTrendBias != 1 and inCall and (
     // Aggressive exits on neutral days
     (emaFast < emaSlow) or  // trend broken
     (close < vwapVal and close[1] >= vwapVal) or  // lost VWAP
     (momentumStalling and not isTrendRegime) or  // momentum died (neutral days only)
     (pivotHigh and close < emaFast))  // structure break

// COMBINE ALL CALL EXITS (hard stops take priority)
optionsExitCall = hardStopHitCall or wrongSideCall or maxLossCapCall or callTrendDayExit or callNeutralDayExit

// PUT exits
bool putTrendDayExit = dayTrendBias == -1 and inPut and (
     // Only exit on STRONG CONFIRMED reversal on PUT days - very high bar
     (emaFast > emaSlow and close > vwapVal and volume > volMA * 1.5 and body > bodyMA * 1.5) or  // Strong reversal with conviction
     (close > emaSlow and body > bodyMA * 1.8 and volume > volMA * 1.5))  // Very clear breakout

bool putNeutralDayExit = dayTrendBias != -1 and inPut and (
     // Aggressive exits on neutral days
     (emaFast > emaSlow) or  // trend broken
     (close > vwapVal and close[1] <= vwapVal) or  // lost VWAP
     (momentumStalling and not isTrendRegime) or  // momentum died (neutral days only)
     (pivotLow and close > emaFast))  // structure break

// COMBINE ALL PUT EXITS (hard stops take priority)
optionsExitPut = hardStopHitPut or wrongSidePut or maxLossCapPut or putTrendDayExit or putNeutralDayExit

// Assign to sellCall/sellPut variables
sellCall = optionsExitCall
sellPut  = optionsExitPut

//────────────────────────────────────
// STATE MANAGEMENT (position flags)
//────────────────────────────────────
if buyCall
    inCall := true
    inPut  := false

if buyPut
    inPut  := true
    inCall := false

if sellCall
    inCall := false

if sellPut
    inPut := false

//────────────────────────────────────
// PRE-SIGNAL (EARLY WARNING) LOGIC
//────────────────────────────────────
preBuyCall =
     not inCall and not inPut and
     close > vwapVal and
     emaFast > emaSlow and
     not noTradeZone

preBuyPut =
     not inCall and not inPut and
     close < vwapVal and
     emaFast < emaSlow and
     not noTradeZone

//────────────────────────────────────
// TOP BANNER: DAY STATE + REGIME + MACRO + PHASE
//────────────────────────────────────
var label banner = na

if barstate.isnew
    label.delete(banner)

    string dayText =
         dayTrendBias == 1  ? "CALL DAY" :
         dayTrendBias == -1 ? "PUT DAY"  :
         inCall ? "CALL POSITION" :
         inPut  ? "PUT POSITION"  :
              "NEUTRAL DAY"

    string regimeText =
         isTrendRegime   ? "Regime: Trend"  :
         isGrindRegime   ? "Regime: Grind"  :
         isNeutralRegime ? "Regime: Neutral" :
                           "Regime: N/A"

    string macroText =
         macroBullMetals ? "Macro: Bullish metals" :
         macroBearMetals ? "Macro: Bearish metals" :
                           "Macro: Neutral"

    string phaseText =
         ideaState == ideaStateProbe     ? "Phase: PROBE" :
         ideaState == ideaStateCore      ? "Phase: CORE" :
         ideaState == ideaStateExpansion ? "Phase: EXPANSION" :
                                           "Phase: OFF"

    string biasText =
         dayBias == 1  ? "Bias: CALL" :
         dayBias == -1 ? "Bias: PUT"  :
                         "Bias: NEUTRAL"

    string bannerPart1 = dayText + " | Conf: " + str.tostring(confidence, "#") + "/5"
    string bannerPart2 = " | " + regimeText + " | " + macroText + " | " + phaseText + " | " + biasText
    string bannerText  = bannerPart1 + bannerPart2

    color bannerColor =
         inCall ? color.new(color.green, 0) :
         inPut  ? color.new(color.red,   0) :
                  color.new(color.gray,  0)

    banner := label.new(
         bar_index, high + atr14 * bannerAtrMult,
         bannerText,
         style     = label.style_label_center,
         color     = bannerColor,
         textcolor = color.white,
         size      = size.large)

//────────────────────────────────────
// PLOTS (VWAP + EMAs + Key Levels)
//────────────────────────────────────
plot(vwapVal, "VWAP",  color = color.orange, linewidth = 2)
plot(emaFast, "EMA 9", color = color.aqua)
plot(emaSlow, "EMA 21",color = color.blue)

// Previous Day High/Low (institutional levels)
plot(prevDayHigh, "Prev Day High", color = color.new(color.red, 70), linewidth = 1, style = plot.style_linebr)
plot(prevDayLow,  "Prev Day Low",  color = color.new(color.green, 70), linewidth = 1, style = plot.style_linebr)

// Opening Range High/Low (first 30 min)
plot(orComplete ? orHigh : na, "OR High", color = color.new(color.purple, 50), linewidth = 2, style = plot.style_stepline)
plot(orComplete ? orLow : na,  "OR Low",  color = color.new(color.purple, 50), linewidth = 2, style = plot.style_stepline)

//────────────────────────────────────
// BIG ENTRY / EXIT LABELS + SIZE TEXT
//────────────────────────────────────

// Vertical spacing so labels don’t cover candles
yBuyCall   = low  - atr14 * entryLabelMult
ySellCall  = high + atr14 * exitLabelMult
yBuyPut    = high + atr14 * entryLabelMult
ySellPut   = low  - atr14 * exitLabelMult

// Only show label on *first* bar of each signal streak
firstBuyCall  = buyCall  and not buyCall[1]
firstSellCall = sellCall and not sellCall[1]
firstBuyPut   = buyPut   and not buyPut[1]
firstSellPut  = sellPut  and not sellPut[1]

// Increment bars-in-trade counter
if (inCall or inPut) and not na(barsSinceEntry)
    barsSinceEntry += 1

// Helper: playbook tag
f_setupTag(bool isCall) =>
    isCall ?
         (isTrendRegime ? "Setup: Trend Long" : "Setup: Other Long") :
         (isTrendRegime ? "Setup: Trend Short" : "Setup: Other Short")

//────────────────────────────────────
// BUY CALL entry block
//────────────────────────────────────
if firstBuyCall
    // 1R distance in price (vol-adjusted)
    float riskDist = effRiskATRMult * atr14

    lastEntryPrice   := close
    lastRiskATR      := riskDist
    lastDirection    := +1
    barsSinceEntry   := 0
    tp1Triggered     := false
    tp2Triggered     := false
    timeStopTriggered := false

    lastTradeWasScalp := isScalpTrade ? true : false
    bool lastTradeWasSwing = isSwingTrade
    maxBarsThisTrade  := lastTradeWasScalp ? maxBarsInTradeScalp : maxBarsInTradeTrend

    // choose RR based on mode (SWING gets higher targets)
    float rrLocalCall = na
    if isSwingTrade
        rrLocalCall := 3.0  // Swing trades target 3R minimum
    else if lastTradeWasScalp
        rrLocalCall := rrMultScalp
    else
        rrLocalCall := isBleedTrend ? math.min(rrMultTrend, 1.0) : rrMultTrend

    float callStop   = close - riskDist
    float callTarget = close + rrLocalCall * riskDist
    currStopPrice    := callStop
    currTargetPrice  := callTarget

    stopLine   := line.new(bar_index, callStop,   bar_index, callStop,   extend = extend.none, color = color.new(color.red,   0), width = 1)
    targetLine := line.new(bar_index, callTarget, bar_index, callTarget, extend = extend.none, color = color.new(color.green, 0), width = 1)

    float oneR_dollar   = riskDist * 100.0
    float contractsF    = oneR_dollar > 0 ? perTradeRiskDollar / oneR_dollar : 0.0
    int   contractsSize = contractsF > 0 ? int(math.round(contractsF)) : 0

    string setupText = f_setupTag(true)
    string modeText  = tradeType  // BREAKOUT, REVERSAL, or CONTINUATION

    string sizeBaseCall =
         ideaState == ideaStateOff ? "Size: NONE (campaign off)" :
         isBleedTrend and not lastTradeWasScalp ? "Size: SMALL (GRIND TREND – aim 0.5R–1R)" :
         extendedFromVWAPEntry or (confidence <= 2) or ideaState == ideaStateProbe ? "Size: SMALL (probe / partial)" :
         (not isTrendRegime or macroNeutral or (confidence <= 4) or ideaState == ideaStateCore) ? "Size: NORMAL" :
         (nearVWAPEntry and isTrendRegime and macroBullMetals and confidence == 5 and ideaState == ideaStateExpansion) ?
             "Size: AGGRESSIVE (scale-in only if working)" :
             "Size: NORMAL"

    string helperTextCall = ""
    if showSizeHelper and oneR_dollar > 0
        helperTextCall := "\n" + modeText + "\n" + setupText + "\n1R ≈ $" + str.tostring(oneR_dollar, "#.##") +
                          "\nSize guide: " + str.tostring(contractsSize) + " contracts"
    else
        helperTextCall := "\n" + modeText + "\n" + setupText

    label.new(
         bar_index, yBuyCall,
         "BUY CALL\n" + sizeBaseCall + helperTextCall,
         style     = label.style_label_up,
         color     = color.new(color.lime, 0),
         textcolor = color.black,
         size      = size.large)

//────────────────────────────────────
// BUY PUT entry block
//────────────────────────────────────
if firstBuyPut
    float riskDist2 = effRiskATRMult * atr14

    lastEntryPrice   := close
    lastRiskATR      := riskDist2
    lastDirection    := -1
    barsSinceEntry   := 0
    tp1Triggered     := false
    tp2Triggered     := false
    timeStopTriggered := false

    lastTradeWasScalp := isScalpTrade ? true : false
    bool lastTradeWasSwing2 = isSwingTrade
    maxBarsThisTrade  := lastTradeWasScalp ? maxBarsInTradeScalp : maxBarsInTradeTrend

    float rrLocalPut = na
    if isSwingTrade
        rrLocalPut := 3.0  // Swing trades target 3R minimum
    else if lastTradeWasScalp
        rrLocalPut := rrMultScalp
    else
        rrLocalPut := isBleedTrend ? math.min(rrMultTrend, 1.0) : rrMultTrend

    float putStop   = close + riskDist2
    float putTarget = close - rrLocalPut * riskDist2
    currStopPrice   := putStop
    currTargetPrice := putTarget

    stopLine   := line.new(bar_index, putStop,   bar_index, putStop,   extend = extend.none, color = color.new(color.red,   0), width = 1)
    targetLine := line.new(bar_index, putTarget, bar_index, putTarget, extend = extend.none, color = color.new(color.green, 0), width = 1)

    float oneR_dollar2   = riskDist2 * 100.0
    float contractsF2    = oneR_dollar2 > 0 ? perTradeRiskDollar / oneR_dollar2 : 0.0
    int   contractsSize2 = contractsF2 > 0 ? int(math.round(contractsF2)) : 0

    string setupText2 = f_setupTag(false)
    string modeText2  = tradeType  // BREAKDOWN, REVERSAL, or CONTINUATION

    string sizeBasePut =
         ideaState == ideaStateOff ? "Size: NONE (campaign off)" :
         isBleedTrend and not lastTradeWasScalp ? "Size: SMALL (GRIND TREND – aim 0.5R–1R)" :
         extendedFromVWAPEntry or (confidence <= 2) or ideaState == ideaStateProbe ? "Size: SMALL (probe / partial)" :
         (not isTrendRegime or macroNeutral or (confidence <= 4) or ideaState == ideaStateCore) ? "Size: NORMAL" :
         (nearVWAPEntry and isTrendRegime and macroBearMetals and confidence == 5 and ideaState == ideaStateExpansion) ?
             "Size: AGGRESSIVE (scale-in only if working)" :
             "Size: NORMAL"

    string helperTextPut = ""
    if showSizeHelper and oneR_dollar2 > 0
        helperTextPut := "\n" + modeText2 + "\n" + setupText2 + "\n1R ≈ $" + str.tostring(oneR_dollar2, "#.##") +
                         "\nSize guide: " + str.tostring(contractsSize2) + " contracts"
    else
        helperTextPut := "\n" + modeText2 + "\n" + setupText2

    label.new(
         bar_index, yBuyPut,
         "BUY PUT\n" + sizeBasePut + helperTextPut,
         style     = label.style_label_down,
         color     = color.new(color.red, 0),
         textcolor = color.white,
         size      = size.large)

//────────────────────────────────────
// CURRENT R + STRUCTURED EXIT LABELS
//────────────────────────────────────
// currentR already calculated above for exit logic

// Extend current trade's lines from entry → current/exit bar
if (inCall or inPut or firstSellCall or firstSellPut)
    if not na(stopLine)
        line.set_x2(stopLine, bar_index)
    if not na(targetLine)
        line.set_x2(targetLine, bar_index)

if (inCall or inPut) and not na(currentR)
    // Move to breakeven at +0.5R, then trail at +1R intervals
    if not tp1Triggered and currentR >= 0.5 and lastRiskATR > 0 and not na(stopLine)
        tp1Triggered := true
        // Move stop to breakeven
        currStopPrice := lastEntryPrice
        line.set_y1(stopLine, currStopPrice)
        line.set_y2(stopLine, currStopPrice)
        label.new(
             bar_index, close,
             "BREAKEVEN @ +0.5R\nProtecting winner",
             style     = (lastDirection == +1 ? label.style_label_down : label.style_label_up),
             color     = color.new(color.yellow, 0),
             textcolor = color.black,
             size      = size.small)
    
    // TP1 ~ +1R (neutral days)
    if not tp1Triggered and currentR >= 1.0
        tp1Triggered := true
        label.new(
             bar_index, close,
             "TP1 ~ +1R\nConsider partial",
             style     = (lastDirection == +1 ? label.style_label_down : label.style_label_up),
             color     = color.new(color.yellow, 0),
             textcolor = color.black,
             size      = size.small)

    // TP2 ~ +2R
    if not tp2Triggered and currentR >= 2.0
        tp2Triggered := true
        label.new(
             bar_index, close,
             "TP2 ~ +2R\nStart trail / protect",
             style     = (lastDirection == +1 ? label.style_label_down : label.style_label_up),
             color     = color.new(color.orange, 0),
             textcolor = color.black,
             size      = size.small)

    // Simple trailing idea: once TP2 is hit, don't let R go back below +1R
    if tp2Triggered and lastRiskATR > 0 and not na(stopLine)
        float newStopPrice = lastDirection == +1 ?
             math.max(currStopPrice, lastEntryPrice + 1.0 * lastRiskATR) :
             math.min(currStopPrice, lastEntryPrice - 1.0 * lastRiskATR)
        if newStopPrice != currStopPrice
            currStopPrice := newStopPrice
            line.set_y1(stopLine, currStopPrice)
            line.set_y2(stopLine, currStopPrice)

    // Time stop if flat after N bars (mode-dependent)
    int maxBars = na(maxBarsThisTrade) ? maxBarsInTradeTrend : maxBarsThisTrade
    if not timeStopTriggered and not na(barsSinceEntry) and barsSinceEntry >= maxBars and math.abs(currentR) < 0.3
        timeStopTriggered := true
        label.new(
             bar_index, close,
             "TIME STOP\nNo progress, consider exit",
             style     = (lastDirection == +1 ? label.style_label_down : label.style_label_up),
             color     = color.new(color.gray, 0),
             textcolor = color.white,
             size      = size.small)

//────────────────────────────────────
// EXIT: SELL CALL with R annotation
//────────────────────────────────────
if firstSellCall
    float tradeR = 0.0
    if not na(lastEntryPrice) and lastRiskATR > 0
        float moveExit       = close - lastEntryPrice
        float signedMoveExit = +1 * moveExit
        tradeR := signedMoveExit / lastRiskATR

    dayPnL_R    += tradeR
    tradesToday += 1
    
    // Track consecutive losses
    if tradeR < 0
        consecutiveLosses += 1
    else
        consecutiveLosses := 0
    lastTradeR := tradeR

    // RTH-only stats store
    if inRTH
        array.push(tradeRsRTH, tradeR)
        if array.size(tradeRsRTH) > statsLookback
            array.shift(tradeRsRTH)
        todayR_RTH     += tradeR
        tradesTodayRTH += 1

    // campaign phase progression (all sessions) - more forgiving
    if ideaState != ideaStateOff
        if dayPnL_R >= 0.5 and ideaState == ideaStateProbe  // Lowered from 1.0
            ideaState := ideaStateCore
        if dayPnL_R >= 2.0 and ideaState == ideaStateCore  // Lowered from 3.0
            ideaState := ideaStateExpansion
        if dayPnL_R <= -4.0  // Increased from -2.0
            ideaState := ideaStateOff

    lastEntryPrice    := na
    lastRiskATR       := na
    lastDirection     := 0
    tp1Triggered      := false
    tp2Triggered      := false
    timeStopTriggered := false
    barsSinceEntry    := na
    maxBarsThisTrade  := na
    lastTradeWasScalp := false

    stopLine        := na
    targetLine      := na
    currStopPrice   := na
    currTargetPrice := na
    
    // Mark exit bar for cooldown tracking
    lastExitBar := bar_index

    string rTextCall = "R: " + str.tostring(tradeR, "#.##")
    
    // Add exit reason for debugging
    string exitReason = (hardStopHitCall ? "STOP HIT" : (wrongSideCall ? "WRONG SIDE" : (maxLossCapCall ? "MAX LOSS" : "EXIT")))

    label.new(
         bar_index, ySellCall,
         "SELL CALL\n" + rTextCall + "\n" + exitReason,
         style     = label.style_label_down,
         color     = color.new(color.green, 10),
         textcolor = color.black,
         size      = size.large)

// EXIT: SELL PUT with R annotation
if firstSellPut
    float tradeR2 = 0.0
    if not na(lastEntryPrice) and lastRiskATR > 0
        float moveExit2       = lastEntryPrice - close
        float signedMoveExit2 = +1 * moveExit2
        tradeR2 := signedMoveExit2 / lastRiskATR

    dayPnL_R    += tradeR2
    tradesToday += 1
    
    // Track consecutive losses
    if tradeR2 < 0
        consecutiveLosses += 1
    else
        consecutiveLosses := 0
    lastTradeR := tradeR2

    if inRTH
        array.push(tradeRsRTH, tradeR2)
        if array.size(tradeRsRTH) > statsLookback
            array.shift(tradeRsRTH)
        todayR_RTH     += tradeR2
        tradesTodayRTH += 1

    if ideaState != ideaStateOff
        if dayPnL_R >= 0.5 and ideaState == ideaStateProbe  // Lowered from 1.0
            ideaState := ideaStateCore
        if dayPnL_R >= 2.0 and ideaState == ideaStateCore  // Lowered from 3.0
            ideaState := ideaStateExpansion
        if dayPnL_R <= -4.0  // Increased from -2.0
            ideaState := ideaStateOff

    lastEntryPrice    := na
    lastRiskATR       := na
    lastDirection     := 0
    tp1Triggered      := false
    tp2Triggered      := false
    timeStopTriggered := false
    barsSinceEntry    := na
    maxBarsThisTrade  := na
    lastTradeWasScalp := false

    stopLine        := na
    targetLine      := na
    currStopPrice   := na
    currTargetPrice := na
    
    // Mark exit bar for cooldown tracking
    lastExitBar := bar_index

    string rTextPut = "R: " + str.tostring(tradeR2, "#.##")
    
    // Add exit reason for debugging
    string exitReason2 = (hardStopHitPut ? "STOP HIT" : (wrongSidePut ? "WRONG SIDE" : (maxLossCapPut ? "MAX LOSS" : "EXIT")))

    label.new(
         bar_index, ySellPut,
         "SELL PUT\n" + rTextPut + "\n" + exitReason2,
         style     = label.style_label_up,
         color     = color.new(color.maroon, 10),
         textcolor = color.white,
         size      = size.large)

//────────────────────────────────────
// MINI STATS DASHBOARD (RTH + TODAY)
//────────────────────────────────────
var table statsTable = table.new(position.top_right, 3, 3, border_width = 1)

if barstate.isnew and showStatsTable
    int totalRTH = array.size(tradeRsRTH)
    float sumR   = 0.0
    int   wins   = 0
    float avgR   = 0.0
    float winRate = 0.0

    if totalRTH > 0
        for i = 0 to totalRTH - 1
            float rVal = array.get(tradeRsRTH, i)
            sumR += rVal
            if rVal > 0
                wins += 1
        avgR    := sumR / totalRTH
        winRate := 100.0 * wins / totalRTH

    string hdrTxt  = totalRTH > 0 ? "Last " + str.tostring(totalRTH) + " RTH trades" : "No RTH trades yet"
    string winTxt  = totalRTH > 0 ? "Win%: " + str.tostring(winRate, "#.##") + "%" : ""
    string avgTxt  = totalRTH > 0 ? "Avg R: " + str.tostring(avgR, "#.##") : ""
    string netTxt  = totalRTH > 0 ? "Net R: " + str.tostring(sumR, "#.##") : ""

    string todayHdr = "Today RTH"
    string todayNet = "Net R: " + str.tostring(todayR_RTH, "#.##")
    string todayTr  = "Trades: " + str.tostring(tradesTodayRTH)

    table.cell(statsTable, 0, 0, hdrTxt,  text_color = color.white, bgcolor = color.new(color.black, 0))
    table.cell(statsTable, 0, 1, winTxt,  text_color = color.white, bgcolor = color.new(color.black, 0))
    table.cell(statsTable, 1, 1, avgTxt,  text_color = color.white, bgcolor = color.new(color.black, 0))
    table.cell(statsTable, 2, 1, netTxt,  text_color = color.white, bgcolor = color.new(color.black, 0))

    table.cell(statsTable, 0, 2, todayHdr, text_color = color.white, bgcolor = color.new(color.black, 0))
    table.cell(statsTable, 1, 2, todayNet, text_color = color.white, bgcolor = color.new(color.black, 0))
    table.cell(statsTable, 2, 2, todayTr,  text_color = color.white, bgcolor = color.new(color.black, 0))

