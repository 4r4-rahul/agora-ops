     color    = color.maroon)

//────────────────────────────────────
// VWAP MEAN-REVERSION SCALP HINTS (Scenario C)
//────────────────────────────────────
scalpLong =
     enableScalpHints and
     not inCall and not inPut and
     distFromVWAPATR >= 0.8 and distFromVWAPATR <= 1.2 and
     close < vwapVal and
     rsi14 < 35 and
     ta.crossover(close, emaFast)

scalpShort =
     enableScalpHints and
     not inCall and not inPut and
     distFromVWAPATR >= 0.8 and distFromVWAPATR <= 1.2 and
     close > vwapVal and
     rsi14 > 65 and
     ta.crossunder(close, emaFast)

if scalpLong
    label.new(
         bar_index, low - atr14 * 0.8,
         "SCALP LONG (VWAP mean reversion)\nTiny size only",
         style     = label.style_label_up,
         color     = color.new(color.teal, 0),
         textcolor = color.white,
         size      = size.small)

if scalpShort
    label.new(
         bar_index, high + atr14 * 0.8,
         "SCALP SHORT (VWAP mean reversion)\nTiny size only",
         style     = label.style_label_down,
         color     = color.new(color.purple, 0),
         textcolor = color.white,
         size      = size.small)

