float volumePoints = 0.0
volumePoints += volume > volMA * 2.5 ? 6.0 : volume > volMA * 2.0 ? 5.0 : volume > volMA * 1.5 ? 3.0 : volume > volMA ? 1.0 : 0.0  // Volume surge
volumePoints += vol3BarBullish or vol3BarBearish ? 5.0 : 0.0  // Institutional sequence
volumePoints += cvd_rising or cvd_falling ? 2.0 : 0.0  // CVD alignment
volumePoints += body > bodyMA * 1.3 ? 2.0 : 0.0  // Strong bodies
volumePoints := math.min(volumePoints, 15.0)  // CAP at 15

// Category 3: Structure Quality (0-15 points, CAP 15)
float structurePoints = 0.0
structurePoints += nearVWAPEntry ? 5.0 : farFromVWAPEntry ? -2.0 : 0.0  // Distance from VWAP
structurePoints += atBand3Upper or atBand3Lower ? 6.0 : atBand2Upper or atBand2Lower ? 3.0 : 0.0  // VWAP band extremes
structurePoints += orBreakoutBullish or orBreakdownBearish ? 6.0 : orRejectionAtHigh or orRejectionAtLow ? 4.0 : 0.0  // OR plays
structurePoints += resistanceExhaustion or supportExhaustion ? 3.0 : 0.0  // Failed breakout exhaustion
structurePoints := math.min(structurePoints, 15.0)  // CAP at 15

// Category 4: Momentum Strength (0-12 points, CAP 12)
float momentumPoints = 0.0
momentumPoints += rsi14 > 70 or rsi14 < 30 ? 4.0 : rsi14 > 60 or rsi14 < 40 ? 2.0 : 0.0  // RSI extremes
momentumPoints += fastMove ? 3.0 : 0.0  // Price speed
momentumPoints += confidence >= 6 ? 5.0 : confidence >= 4 ? 3.0 : confidence >= 2 ? 1.0 : 0.0  // System confidence
momentumPoints := math.min(momentumPoints, 12.0)  // CAP at 12

// Category 5: Volatility State (0-10 points, CAP 10)
float volatilityPoints = 0.0
volatilityPoints += isExpandingFast and atrAccelerating ? 6.0 : isExpanding ? 3.0 : 0.0  // Expansion + acceleration
volatilityPoints += isSqueezed ? 4.0 : isContracted ? 2.0 : 0.0  // Compression (potential energy)
volatilityPoints -= ivElevated ? 3.0 : 0.0  // Penalty for expensive options
volatilityPoints := math.min(volatilityPoints, 10.0)  // CAP at 10

// Category 6: Time-of-Day (0-10 points, CAP 10)
float timePoints = 0.0
timePoints += (trendFavorableTime and isStrongTrend) or (reversalFavorableTime and isMeanReversion) ? 5.0 : 0.0  // Favorable hours
timePoints += isOpeningRange ? 3.0 : isPowerHour ? 2.0 : 0.0  // High volume windows
timePoints -= isMidDay ? 3.0 : 0.0  // Penalty for chop zone
timePoints -= highThetaRisk ? 2.0 : 0.0  // Penalty for 0DTE after 14:00
timePoints -= fridayTheta ? 2.0 : 0.0  // Penalty for Friday PM
timePoints := math.min(timePoints, 10.0)  // CAP at 10

// Category 7: Reversal Patterns (0-20 points, CAP 20)
float reversalPoints = 0.0
if isMeanReversion  // Only score in Mean Reversion regime
    reversalPoints += swingRejectionLongGrade == "A" or swingRejectionShortGrade == "A" ? 10.0 : swingRejectionLongGrade == "B" or swingRejectionShortGrade == "B" ? 7.0 : swingRejectionLongGrade == "C" or swingRejectionShortGrade == "C" ? 4.0 : 0.0
    reversalPoints += failedBreakdownLong or failedBreakoutShort ? 5.0 : 0.0
    reversalPoints += htfBullishReversal or htfBearishReversal ? 3.0 : 0.0
    reversalPoints += strongUpperWick or strongLowerWick ? 2.0 : 0.0
reversalPoints := math.min(reversalPoints, 20.0)  // CAP at 20

// Category 8: Multi-bar Confirmation + Edges (0-8 points, CAP 8)
float edgePoints = 0.0
edgePoints += bull3BarPattern or bear3BarPattern ? 3.0 : bull2BarSurge or bear2BarSurge ? 2.0 : 0.0
edgePoints += htfTransitioning ? 2.0 : 0.0  // HTF turning point
edgePoints += breakoutConditionLong or breakoutConditionShort ? 3.0 : 0.0  // Breakout ignition
edgePoints += (trendSlopeLong and followThroughLong) or (trendSlopeShort and followThroughShort) ? 3.0 : 0.0  // Slope + follow-through
edgePoints := math.min(edgePoints, 8.0)  // CAP at 8

// Continuation bonus (boost clean trend follow-through)
float bonusPoints = 0.0
bonusPoints += (trendSlopeLong and followThroughLong and close > emaFast and emaFast > emaSlow and vwapUp and volume > volMA) ? 3.0 : 0.0
bonusPoints += (trendSlopeShort and followThroughShort and close < emaFast and emaFast < emaSlow and vwapDown and volume > volMA) ? 3.0 : 0.0
bonusPoints += (isStrongTrend and fastMove) ? 2.0 : 0.0
bonusPoints += ((htfUp and isBullPhase and close > vwapVal) or (htfDown and isBearPhase and close < vwapVal)) ? 2.0 : 0.0  // HTF + phase alignment
bonusPoints += (orBreakoutBullish or orBreakdownBearish) and (trendSlopeLong or trendSlopeShort) ? 2.0 : 0.0  // OR breakout continuation
bonusPoints += (isExpandingFast and atrAccelerating and volume > volMA * 1.5) ? 2.0 : 0.0  // Ignition + volume
bonusPoints += (cvd_rising and close > open) or (cvd_falling and close < open) ? 1.0 : 0.0  // Order flow push

// Penalty adjustments (reduce low-quality setups)
float penaltyPoints = 0.0
penaltyPoints += extendedFromVWAPEntry and not isMeanReversion ? 4.0 : 0.0  // Late extension without mean reversion
penaltyPoints += isNeutralChop and not (fastMove or breakoutConditionLong or breakoutConditionShort) ? 3.0 : 0.0  // Chop penalty
penaltyPoints += wickToBodyRatio > 2.5 ? 2.0 : 0.0  // Wicky/illiquid candles
penaltyPoints += (trendSlopeLong and not followThroughLong) or (trendSlopeShort and not followThroughShort) ? 2.0 : 0.0  // No follow-through
penaltyPoints += isBleedTrend and not fastMove ? 2.0 : 0.0  // Slow bleed day penalty
penaltyPoints += highThetaRisk and isWeakTrend ? 2.0 : 0.0  // Late-day weak trend penalty
penaltyPoints += microChop ? 1.0 : 0.0  // VWAP/EMA compression
penaltyPoints += (rsiCenterish and isNeutralChop) ? 1.0 : 0.0  // RSI stuck in middle
penaltyPoints += (not vwapUp and not vwapDown) ? 1.0 : 0.0  // Flat VWAP
penaltyPoints += (atrDecelerating and not isMeanReversion) ? 0.0 : 0.0  // Cooling volatility

