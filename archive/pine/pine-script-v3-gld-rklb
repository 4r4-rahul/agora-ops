//@version=5
indicator("Rahul Momentum Options Engine PRO (v6.0 + Order Flow + MTF + Reversals)", overlay = true, max_labels_count = 500)

//════════════════════════════════════════════════════════════════════
// 🆕 NEW IN V6.0:
// ✓ Order Flow Proxies (Volume Delta, CVD, Wick Analysis)
// ✓ Multi-Timeframe Structure Analysis
// ✓ Advanced Confidence Scoring (8-factor model)
// ✓ REVERSAL TRANSITION Regime
// ✓ Swing Rejection Pattern Detection
// ✓ Failed Breakdown/Breakout Detection
// ✓ Dual Exit Logic (different for reversals vs trends)
// ✓ Position Scaling System (probe → scale in)
//════════════════════════════════════════════════════════════════════

//────────────────────────────────────
// CORE INDICATORS
//────────────────────────────────────
vwapVal = ta.vwap(close)
emaFast = ta.ema(close, 9)
emaSlow = ta.ema(close, 21)

// 🎯 PROFESSIONAL EDGE: VWAP Standard Deviation Bands
// These act as support/resistance zones (institutional reference)
vwapStdDev = ta.stdev(close - vwapVal, 20)
vwapBand1Upper = vwapVal + 0.5 * vwapStdDev  // Light resistance
vwapBand1Lower = vwapVal - 0.5 * vwapStdDev  // Light support
vwapBand2Upper = vwapVal + 1.0 * vwapStdDev  // Strong resistance
vwapBand2Lower = vwapVal - 1.0 * vwapStdDev  // Strong support
vwapBand3Upper = vwapVal + 2.0 * vwapStdDev  // Extreme resistance (reversal zone)
vwapBand3Lower = vwapVal - 2.0 * vwapStdDev  // Extreme support (reversal zone)

// Price position relative to bands
atBand2Upper = high >= vwapBand2Upper * 0.998  // Within 0.2% of upper band
atBand2Lower = low <= vwapBand2Lower * 1.002   // Within 0.2% of lower band
atBand3Upper = high >= vwapBand3Upper * 0.998  // Extreme stretch (fade zone)
atBand3Lower = low <= vwapBand3Lower * 1.002   // Extreme stretch (fade zone)

volMA  = ta.sma(volume, 20)
body   = math.abs(close - open)
bodyMA = ta.sma(body, 20)

atr14  = ta.atr(14)
rsi14  = ta.rsi(close, 14)

// Distance from VWAP in ATR units
distFromVWAPATR       = math.abs(close - vwapVal) / atr14
nearVWAPEntry         = distFromVWAPATR <= 0.6
farFromVWAPEntry      = distFromVWAPATR >= 1.0
extendedFromVWAPEntry = distFromVWAPATR > 1.2

//────────────────────────────────────
// 🆕 ADX (TREND STRENGTH FILTER)
//────────────────────────────────────
adxLen = 14
adxSmoothing = 14

// True Range and Directional Movement
trueRange = math.max(math.max(high - low, math.abs(high - close[1])), math.abs(low - close[1]))
dmPlus = high - high[1] > low[1] - low ? math.max(high - high[1], 0) : 0
dmMinus = low[1] - low > high - high[1] ? math.max(low[1] - low, 0) : 0

// Smoothed values
var float trSmooth = 0.0
var float dmPlusSmooth = 0.0
var float dmMinusSmooth = 0.0

if bar_index == 0
    trSmooth := 0
    dmPlusSmooth := 0
    dmMinusSmooth := 0
else
    trSmooth := trSmooth - (trSmooth / adxLen) + trueRange
    dmPlusSmooth := dmPlusSmooth - (dmPlusSmooth / adxLen) + dmPlus
    dmMinusSmooth := dmMinusSmooth - (dmMinusSmooth / adxLen) + dmMinus

// Directional Indicators
diPlus = trSmooth != 0 ? (dmPlusSmooth / trSmooth) * 100 : 0
diMinus = trSmooth != 0 ? (dmMinusSmooth / trSmooth) * 100 : 0

// DX and ADX
dx = diPlus + diMinus != 0 ? math.abs(diPlus - diMinus) / (diPlus + diMinus) * 100 : 0
adx = ta.sma(dx, adxSmoothing)

// ADX-based market classification
adxChop = adx < 18        // Choppy, low quality
adxWeakTrend = adx >= 18 and adx < 30  // Weak trend, cautious
adxStrongTrend = adx >= 30 and adx < 40  // Strong trend, ideal
adxVeryStrong = adx >= 40  // Very strong trend, explosive

// Directional bias from DI
adxBullish = diPlus > diMinus
adxBearish = diMinus > diPlus

//────────────────────────────────────
// 🆕 PHASE 2A: COMPRESSION & ACCELERATION
//────────────────────────────────────
// BB Width: Detects volatility compression (squeeze) → expansion (ignition)
bbLength = 20
bbMult = 2.0
bbBasis = ta.sma(close, bbLength)
bbDev = bbMult * ta.stdev(close, bbLength)
bbUpper = bbBasis + bbDev
bbLower = bbBasis - bbDev
bbWidth = (bbUpper - bbLower) / bbBasis * 100.0  // Width as % of price

// BB Width percentile (where are we in 100-bar range?)
bbWidthLowest = ta.lowest(bbWidth, 100)
bbWidthHighest = ta.highest(bbWidth, 100)
bbWidthPercentile = bbWidthHighest > bbWidthLowest ? (bbWidth - bbWidthLowest) / (bbWidthHighest - bbWidthLowest) * 100.0 : 50.0

// Volatility states
isSqueezed = bbWidthPercentile < 20  // Bottom 20% = compression
isExpanding = bbWidth > bbWidth[1] and bbWidth[1] > bbWidth[2]  // 2-bar expansion
isExpandingFast = bbWidth > bbWidth[1] * 1.1  // 10%+ width increase = ignition
isContracted = bbWidthPercentile < 30 and not isSqueezed

// ATR Rate of Change: Measures trend acceleration (catching ignition phase)
atrROC = atr14 > atr14[5] ? (atr14 - atr14[5]) / atr14[5] * 100.0 : 0.0
atrAccelerating = atrROC > 15.0  // ATR increasing >15% over 5 bars
atrDecelerating = atr14 < atr14[5] and atr14[5] < atr14[10]  // ATR declining (exhaustion)

//────────────────────────────────────
// 🆕 ORDER FLOW PROXIES
//────────────────────────────────────
enableOrderFlow = input.bool(true, "Enable Order Flow Analysis", group="Order Flow")
showCVD         = input.bool(true, "Show CVD Plot", group="Order Flow")

// Approximate Buy/Sell Volume (based on candle direction)
buyVol  = close > open ? volume : (close == open ? volume / 2 : 0)
sellVol = close < open ? volume : (close == open ? volume / 2 : 0)
volumeDelta = buyVol - sellVol

// Cumulative Volume Delta
var float cvd = 0.0
if barstate.isfirst
    cvd := 0
cvd := cvd + volumeDelta

// CVD divergence detection
cvd_ma = ta.sma(cvd, 10)
cvd_rising = cvd > cvd_ma and cvd > cvd[5]
cvd_falling = cvd < cvd_ma and cvd < cvd[5]

// Wick Analysis (rejection strength)
upperWick = high - math.max(open, close)
lowerWick = math.min(open, close) - low
upperWickStrength = upperWick / atr14
lowerWickStrength = lowerWick / atr14

strongLowerWick = lowerWickStrength > 0.5  // Strong buying pressure
strongUpperWick = upperWickStrength > 0.5  // Strong selling pressure

// Volume Spike (institutional activity)
volumeSpike = volume > volMA * 2.0
extremeVolumeSpike = volume > volMA * 3.0

// 🎯 PROFESSIONAL EDGE: Volume Sequence Detection (Smart Money Footprints)
// 3+ consecutive high volume bars = institutional accumulation/distribution
bool vol3BarHigh = volume > volMA * 1.3 and volume[1] > volMA * 1.3 and volume[2] > volMA * 1.3
bool vol3BarBullish = vol3BarHigh and close > close[1] and close[1] > close[2]  // Accumulation
bool vol3BarBearish = vol3BarHigh and close < close[1] and close[1] < close[2]  // Distribution

// Price Speed/Momentum (how fast price is moving)
priceSpeed = math.abs(close - close[5]) / (atr14 * 5)
fastMove = priceSpeed > 0.3  // Moving >30% of ATR per bar on average

// Optional CVD plot
plot(showCVD ? cvd : na, "CVD", color=color.new(cvd_rising ? color.green : color.red, 50), linewidth=2)

//────────────────────────────────────
// 🆕 MULTI-TIMEFRAME STRUCTURE ANALYSIS
//────────────────────────────────────
htfTF = input.timeframe("3", "HTF timeframe for structure", group="MTF Analysis")

// HTF indicators
htfClose  = request.security(syminfo.tickerid, htfTF, close)
htfOpen   = request.security(syminfo.tickerid, htfTF, open)
htfHigh   = request.security(syminfo.tickerid, htfTF, high)
htfLow    = request.security(syminfo.tickerid, htfTF, low)
htfEMA20  = request.security(syminfo.tickerid, htfTF, ta.ema(close, 20))
htfRSI    = request.security(syminfo.tickerid, htfTF, ta.rsi(close, 14))
htfVolume = request.security(syminfo.tickerid, htfTF, volume)
htfVolMA  = request.security(syminfo.tickerid, htfTF, ta.sma(volume, 20))

// HTF trend direction
htfUp     = htfClose > htfEMA20
htfDown   = htfClose < htfEMA20

// HTF swing structure (for reversals)
htfHighest20 = request.security(syminfo.tickerid, htfTF, ta.highest(high, 20))
htfLowest20  = request.security(syminfo.tickerid, htfTF, ta.lowest(low, 20))

htfNearHigh = high >= htfHighest20 * 0.998  // Within 0.2% of 20-bar high
htfNearLow  = low <= htfLowest20 * 1.002    // Within 0.2% of 20-bar low

// HTF reversal signs
htfBullishReversal = htfDown and htfRSI < 35 and htfVolume > htfVolMA * 1.5
htfBearishReversal = htfUp and htfRSI > 65 and htfVolume > htfVolMA * 1.5

// HTF momentum weakening (reversal setup)
htfBullMomentumWeak = htfUp and htfRSI < 55 and htfClose < htfEMA20[1]
htfBearMomentumWeak = htfDown and htfRSI > 45 and htfClose > htfEMA20[1]

// � PROFESSIONAL EDGE: Failed Breakout Counter (Exhaustion Detection)
// Multiple failed attempts at same level = high probability reversal
var float resistanceLevel = na
var int resistanceTests = 0
var float supportLevel = na
var int supportTests = 0

// Track resistance tests (bull trap setup)
if high > high[1] and high > ta.highest(high[2], 10)
    if not na(resistanceLevel) and math.abs(high - resistanceLevel) < atr14 * 0.3
        resistanceTests += 1  // Same level tested again
    else
        resistanceLevel := high
        resistanceTests := 1

// Track support tests (bear trap setup)
if low < low[1] and low < ta.lowest(low[2], 10)
    if not na(supportLevel) and math.abs(low - supportLevel) < atr14 * 0.3
        supportTests += 1  // Same level tested again
    else
        supportLevel := low
        supportTests := 1

// Reset counters if price breaks through
if close > resistanceLevel + atr14 * 0.5
    resistanceTests := 0
    resistanceLevel := na
if close < supportLevel - atr14 * 0.5
    supportTests := 0
    supportLevel := na

// Exhaustion flags (2-3 failed attempts = reversal setup)
bool resistanceExhaustion = resistanceTests >= 2 and resistanceTests <= 4
bool supportExhaustion = supportTests >= 2 and supportTests <= 4

// �🆕 PHASE 2A: HTF TRANSITIONING STATES
// Catches HTF turning points (best entry timing)
htfTurningBullish = htfDown[1] and htfClose > htfEMA20 and htfRSI > 40  // HTF flipping up
htfTurningBearish = htfUp[1] and htfClose < htfEMA20 and htfRSI < 60  // HTF flipping down
htfTransitioning = htfTurningBullish or htfTurningBearish  // HTF in transition

//────────────────────────────────────
// VISUAL / BEHAVIOR INPUTS
//────────────────────────────────────
entryLabelMult  = input.float(1.2, "Entry label distance (ATR)", minval = 0.5, step = 0.1, group="Display")
exitLabelMult   = input.float(1.8, "Exit label distance (ATR)",  minval = 0.5, step = 0.1, group="Display")
bannerAtrMult   = input.float(2.5, "Banner distance (ATR)",      minval = 1.0, step = 0.1, group="Display")

showTinyMarks   = input.bool(true,  "Show tiny markers on candles", group="Display")
showRegimeBg    = input.bool(false, "Show regime background", group="Display")
showSkipLabels  = input.bool(false, "Show skip labels", group="Display")

useLunchFilter  = input.bool(true,  "Use no-trade zone (lunch)", group="Sessions")
LunchSession = input.session("1130-1300", "No-trade session (exchange time)", group="Sessions")
AfternoonTrendSession = input.session("1300-1600", "Trend re-arm session (exchange time)", group="Sessions")
RTHSession   = input.session("0930-1600", "RTH session (exchange time)", group="Sessions")

// Macro symbols
dxySymbol    = input.symbol("DXY",   "Dollar index symbol (DXY)", group="Macro")
us10ySymbol  = input.symbol("US10Y", "10Y yield symbol", group="Macro")

// Stop / target config for lines
riskATRMult   = input.float(1.0, "Base stop distance (ATR multiples)", minval = 0.1, step = 0.1, group="Risk Management")
rrMultTrend   = input.float(2.0, "Target R multiple – TREND", minval = 0.5, step = 0.5, group="Risk Management")
rrMultScalp   = input.float(1.0, "Target R multiple – SCALP", minval = 0.2, step = 0.1, group="Risk Management")
rrMultReversal = input.float(3.0, "Target R multiple – REVERSAL", minval = 1.0, step = 0.5, group="Risk Management")

// Time stops
maxBarsInTradeTrend    = input.int(15, "Max bars in trade – TREND", minval = 1, maxval = 100, group="Time Stops")
maxBarsInTradeScalp    = input.int(8,  "Max bars in trade – SCALP", minval = 1, maxval = 100, group="Time Stops")
maxBarsInTradeReversal = input.int(25, "Max bars in trade – REVERSAL", minval = 5, maxval = 100, group="Time Stops")
minHoldBars            = input.int(2,  "Min hold bars before exit", minval = 0, maxval = 10, group="Time Stops")
adverseExitR            = input.float(0.6, "Adverse override (R)", minval = 0.2, maxval = 2.0, step = 0.1, group="Time Stops")

// Dynamic $-R + contract helper
acctEquity      = input.float(2000, "Account equity ($)", minval = 100, group="Position Sizing")
riskPctPerTrade = input.float(1.0,  "Risk per trade (% of equity)", minval = 0.1, maxval = 5.0, group="Position Sizing")
showSizeHelper  = input.bool(true,  "Show 1R $ & contract size guide", group="Position Sizing")

// 🆕 Scaling settings
enableScaling      = input.bool(true, "Enable Position Scaling (probe → scale in)", group="Position Sizing")
initialPositionPct = input.float(33.0, "Initial position size (%)", minval=10, maxval=100, step=5, group="Position Sizing")

// Filters
useChopFilter = input.bool(true,  "Use micro-chop filter", group="Filters")
useVolAdjust  = input.bool(true,  "Auto-adjust risk by volatility", group="Filters")
minConfidence = input.int(1, "Minimum confidence for entry (1-8)", minval=1, maxval=8, group="Filters")
useHardStops  = input.bool(false, "Use hard stops (strict blocks)", group="Filters")
useGLDStrict  = input.bool(true, "GLD strict neutral/chop filter", group="Filters")

// 🆕 PHASE 2B: ENTRY MODE SELECTION
enableBreakoutMode = input.bool(true, "Enable Breakout Mode (early entries)", group="Filters")
breakoutModeAggression = input.string("Medium", "Breakout aggression", options=["Conservative", "Medium", "Aggressive"], group="Filters")

// 🆕 Reversal pattern toggles
enableSwingRejection  = input.bool(true, "Enable Swing Rejection Pattern", group="Reversal Patterns")
enableFailedBreakdown = input.bool(true, "Enable Failed Breakdown/Breakout", group="Reversal Patterns")

// Stats dashboard
statsLookback  = input.int(20, "Stats lookback (RTH trades)", minval = 5, maxval = 100, group="Stats")
showStatsTable = input.bool(true, "Show stats dashboard (RTH)", group="Stats")

//────────────────────────────────────
// MOMENTUM EXTENSION LOGIC (CALL / PUT)
//────────────────────────────────────

// VWAP slope
vwapUp   = vwapVal > vwapVal[1]
vwapDown = vwapVal < vwapVal[1]

// Trend slope + follow-through (quality boost for continuation)
emaFastSlope = emaFast - emaFast[1]
vwapSlope    = vwapVal - vwapVal[1]
trendSlopeLong  = emaFastSlope > 0 and vwapSlope > 0
trendSlopeShort = emaFastSlope < 0 and vwapSlope < 0
followThroughLong  = close > high[1]
followThroughShort = close < low[1]

// Micro-chop: price hugging VWAP & EMAs tight
emaSpread   = math.abs(emaFast - emaSlow)
microChop   = distFromVWAPATR < 0.2 and emaSpread < atr14 * 0.05
allowTrade  = not useChopFilter or not microChop

// Bull momentum (CALL) - original logic
bullMomentum =
     close   > vwapVal and
     emaFast > emaSlow and
     vwapUp  and
     body    > bodyMA and
     volume  > volMA and
     allowTrade

// Bear momentum (PUT) - original logic
bearMomentum =
     close   < vwapVal and
     emaFast < emaSlow and
     vwapDown and
     body    > bodyMA and
     volume  > volMA and
     allowTrade

// 🆕 WEAK TREND DETECTION (Professional Setup)
// Detects grinding trends near VWAP with structural bias + order flow confirmation
// Common in metals distribution/accumulation phases

// Structural bias (making lower lows or higher highs)
var float recentHigh = high
var float recentLow = low
if high > recentHigh or bar_index == 0
    recentHigh := high
if low < recentLow or bar_index == 0
    recentLow := low

lowerLowStructure = low < ta.lowest(low[1], 10)  // Making lower lows
higherHighStructure = high > ta.highest(high[1], 10)  // Making higher highs

// Weak Bull Trend (grind up near VWAP)
weakBullTrend = close > vwapVal and emaFast > emaSlow and nearVWAPEntry and higherHighStructure and (enableOrderFlow ? cvd_rising : true) and volume > volMA * 0.8 and allowTrade

// Weak Bear Trend (grind down near VWAP) - THIS IS YOUR SLV PATTERN
weakBearTrend = close < vwapVal and emaFast < emaSlow and nearVWAPEntry and lowerLowStructure and (enableOrderFlow ? cvd_falling : true) and volume > volMA * 0.8 and allowTrade

// 🆕 PHASE 2C: MULTI-BAR CONFIRMATION PATTERNS
// 2-3 bar patterns for higher probability (institutional accumulation/distribution)

// 3-bar bullish confirmation: consecutive closes above VWAP + EMA alignment
bull3BarPattern = close > vwapVal and close[1] > vwapVal and close[2] > vwapVal and emaFast > emaSlow and emaFast[1] > emaSlow[1] and volume > volMA

// 3-bar bearish confirmation: consecutive closes below VWAP + EMA alignment  
bear3BarPattern = close < vwapVal and close[1] < vwapVal and close[2] < vwapVal and emaFast < emaSlow and emaFast[1] < emaSlow[1] and volume > volMA

// 2-bar momentum surge: strong body + volume on both bars
bull2BarSurge = close > close[1] and close[1] > close[2] and body > bodyMA and body[1] > bodyMA and volume > volMA * 1.2 and volume[1] > volMA * 1.2

bear2BarSurge = close < close[1] and close[1] < close[2] and body > bodyMA and body[1] > bodyMA and volume > volMA * 1.2 and volume[1] > volMA * 1.2

//────────────────────────────────────
// 🆕 MARKET PHASE (30-BAR PERSISTENCE)
//────────────────────────────────────
// Prevents phase flip-flopping from single bars
// Requires structural confirmation over 30 bars

// 30-bar structure analysis
ema20 = ta.ema(close, 20)
highest30 = ta.highest(high, 30)
lowest30 = ta.lowest(low, 30)

// Higher Highs / Higher Lows (bull structure)
hhCount = 0
hlCount = 0
for i = 1 to 5
    if high[i] > high[i+5]
        hhCount += 1
    if low[i] > low[i+5]
        hlCount += 1

// Lower Highs / Lower Lows (bear structure)
lhCount = 0
llCount = 0
for i = 1 to 5
    if high[i] < high[i+5]
        lhCount += 1
    if low[i] < low[i+5]
        llCount += 1

// Structure quality
bullStructure = hhCount >= 3 and hlCount >= 2
bearStructure = lhCount >= 3 and llCount >= 2
neutralStructure = not bullStructure and not bearStructure

// Phase conditions (requires multiple confirmations)
bullPhaseCondition = close > ema20 and bullStructure and rsi14 > 45 and emaFast > emaSlow
bearPhaseCondition = close < ema20 and bearStructure and rsi14 < 55 and emaFast < emaSlow
neutralPhaseCondition = neutralStructure or (rsi14 > 45 and rsi14 < 55)

// Phase state with persistence (requires 3 bars confirmation to flip)
var string marketPhase = "NEUTRAL"
var int phaseConfirmCount = 0
var string pendingPhase = "NEUTRAL"

// Determine what phase wants to be
string wantedPhase = bullPhaseCondition ? "BULL" : bearPhaseCondition ? "BEAR" : "NEUTRAL"

// Count confirmation bars
if wantedPhase != marketPhase
    if wantedPhase == pendingPhase
        phaseConfirmCount += 1
    else
        pendingPhase := wantedPhase
        phaseConfirmCount := 1
    
    // Switch phase after 3 confirmation bars
    if phaseConfirmCount >= 3
        marketPhase := wantedPhase
        phaseConfirmCount := 0
else
    phaseConfirmCount := 0
    pendingPhase := marketPhase

// Phase booleans
isBullPhase = marketPhase == "BULL"
isBearPhase = marketPhase == "BEAR"
isNeutralPhase = marketPhase == "NEUTRAL"

// 🆕 PHASE 2A: PHASE TRANSITIONING
// When phase is shifting (1-2 bars into new confirmation), entries allowed
// 🔥 FIX: Require ADX support (not in chop)
isPhaseTransitioning = phaseConfirmCount > 0 and phaseConfirmCount <= 2 and not adxChop and (adxWeakTrend or adxStrongTrend or adxVeryStrong)

//────────────────────────────────────
// 🆕 REVERSAL PATTERN DETECTION
//────────────────────────────────────

// SWING REJECTION LONG (reversal from downtrend)
swingRejectionLong = false
if enableSwingRejection
    // Price made lower low
    lowerLow = low < ta.lowest(low[1], 10)
    
    // RSI made higher low (bullish divergence)
    rsiHigherLow = rsi14 > ta.lowest(rsi14[1], 10) and rsi14 < 35
    
    // Strong rejection (lower wick + close above EMA9)
    strongRejection = lowerWickStrength > 0.5 and close > emaFast
    
    // Volume confirmation
    volConfirm = volumeSpike
    
    // Extended from VWAP (oversold)
    extended = distFromVWAPATR > 0.8 and distFromVWAPATR < 2.0 and close < vwapVal
    
    // HTF supports reversal
    htfSupport = htfBullishReversal or htfNearLow
    
    swingRejectionLong := lowerLow and rsiHigherLow and strongRejection and volConfirm and extended and htfSupport

// SWING REJECTION SHORT (reversal from uptrend)
swingRejectionShort = false
if enableSwingRejection
    // Price made higher high
    higherHigh = high > ta.highest(high[1], 10)
    
    // RSI made lower high (bearish divergence)
    rsiLowerHigh = rsi14 < ta.highest(rsi14[1], 10) and rsi14 > 65
    
    // Strong rejection (upper wick + close below EMA9)
    strongRejection = upperWickStrength > 0.5 and close < emaFast
    
    // Volume confirmation
    volConfirm = volumeSpike
    
    // Extended from VWAP (overbought)
    extended = distFromVWAPATR > 0.8 and distFromVWAPATR < 2.0 and close > vwapVal
    
    // HTF supports reversal
    htfSupport = htfBearishReversal or htfNearHigh
    
    swingRejectionShort := higherHigh and rsiLowerHigh and strongRejection and volConfirm and extended and htfSupport

// FAILED BREAKDOWN LONG (bear trap)
failedBreakdownLong = false
if enableFailedBreakdown
    // Price broke below recent low
    recentLow := ta.lowest(low[1], 20)
    brokeBelow = low[1] < recentLow and low[2] >= recentLow
    
    // But quickly reclaimed (within 3 bars)
    var int brokeBelowBar = na
    if brokeBelow
        brokeBelowBar := bar_index
    reclaimed = close > recentLow and not na(brokeBelowBar) and bar_index - brokeBelowBar <= 3
    
    // Volume increased on breakdown (selling climax)
    volOnBreakdown = volume[1] > volMA * 1.5
    
    // Now closing back above EMA9
    backAboveEma = close > emaFast
    
    // CVD showing buying pressure
    cvdBullish = enableOrderFlow ? cvd_rising : true
    
    failedBreakdownLong := brokeBelow and reclaimed and volOnBreakdown and backAboveEma and cvdBullish

// FAILED BREAKOUT SHORT (bull trap)
failedBreakoutShort = false
if enableFailedBreakdown
    // Price broke above recent high
    recentHigh := ta.highest(high[1], 20)
    brokeAbove = high[1] > recentHigh and high[2] <= recentHigh
    
    // But quickly failed (within 3 bars)
    var int brokeAboveBar = na
    if brokeAbove
        brokeAboveBar := bar_index
    failed = close < recentHigh and not na(brokeAboveBar) and bar_index - brokeAboveBar <= 3
    
    // Volume increased on breakout (buying climax)
    volOnBreakout = volume[1] > volMA * 1.5
    
    // Now closing back below EMA9
    backBelowEma = close < emaFast
    
    // CVD showing selling pressure
    cvdBearish = enableOrderFlow ? cvd_falling : true
    
    failedBreakoutShort := brokeAbove and failed and volOnBreakout and backBelowEma and cvdBearish

//────────────────────────────────────
// 🆕 ADVANCED CONFIDENCE SCORING (1-8)
//────────────────────────────────────
float confidence = 0.0

// Factor 1: Body strength
confidence += body > bodyMA ? 1.0 : 0.0

// Factor 2: Volume
confidence += volume > volMA ? 1.0 : 0.0
confidence += volumeSpike ? 0.5 : 0.0  // Bonus for spike

// Factor 3: EMA spread (momentum strength)
confidence += emaSpread > atr14 * 0.2 ? 1.0 : 0.0

// Factor 4: VWAP alignment (meaningful slope, not just direction)
vwapSlopeStrongUp = vwapSlope > atr14 * 0.02
vwapSlopeStrongDown = vwapSlope < -atr14 * 0.02
confidence += (vwapSlopeStrongUp or vwapSlopeStrongDown) ? 1.0 : 0.0

// Factor 5: RSI position
