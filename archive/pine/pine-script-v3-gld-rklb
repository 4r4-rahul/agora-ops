confidence += enableOrderFlow and cvd_falling and close < open and close < vwapVal ? 1.0 : 0.0

// 🎯 EDGE BONUS: Volume sequence (institutional footprint)
confidence += vol3BarBullish and close > vwapVal ? 1.0 : 0.0
confidence += vol3BarBearish and close < vwapVal ? 1.0 : 0.0

// Factor 8: Wick rejection (strength)
confidence += strongLowerWick and close > open ? 0.5 : 0.0
confidence += strongUpperWick and close < open ? 0.5 : 0.0

