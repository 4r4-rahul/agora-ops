confidence += (rsi14 > 60 or rsi14 < 40) ? 0.5 : 0.0  // Bonus for extreme

// Factor 6: HTF alignment
confidence += (htfUp and close > vwapVal) or (htfDown and close < vwapVal) ? 1.0 : 0.0

// Factor 7: Order flow confirmation (directional)
