    // Adjust for initial position size if scaling
    if enableScaling and lastSetupType == "REVERSAL"
        contractsSize := int(math.round(contractsSize * initialPositionPct / 100.0))

    string setupText = currentSetupType == "REVERSAL" ? ("Setup: REVERSAL Long (Score " + str.tostring(qualityScore, "#") + ")") : currentSetupType == "WEAK_TREND" ? "Setup: Weak Trend Long" : currentSetupType == "BREAKOUT" ? "Setup: BREAKOUT (early)" : currentSetupType == "SCALP" ? "Setup: Scalp Long" : "Setup: Trend Long"

    string modeText = "Regime: " + regimeType + " | Score: " + str.tostring(qualityScore, "#") + "/100"

    string sizeText = ideaState == ideaStateOff ? "Size: NONE (campaign off)" : sizingMultiplier >= 0.8 ? "Size: LARGE" : sizingMultiplier >= 0.5 ? "Size: NORMAL" : sizingMultiplier >= 0.3 ? "Size: SMALL" : "Size: PROBE"

    string helperText = ""
    if showSizeHelper and oneR_dollar > 0
        string qualityText = "Mult: " + str.tostring(sizingMultiplier, "#.##") + "x | RR: " + str.tostring(rrLocal, "#.#") + "R"
        string optionsText = "🎯 " + strikeGuidanceNew + " | " + expirationGuidanceNew
        helperText := "\n" + modeText + "\n" + setupText + "\n" + qualityText + "\n" + optionsText + "\n1R ≈ $" + str.tostring(oneR_dollar, "#.##") +
                      "\nSize guide: " + str.tostring(contractsSize) + " contracts"
    else
        helperText := "\n" + modeText + "\n" + setupText

    color labelColor = currentSetupType == "REVERSAL" ? color.purple : currentSetupType == "BREAKOUT" ? color.blue : color.lime
    label.new(bar_index, yBuyCall, "BUY CALL\n" + sizeText + helperText, style = label.style_label_up, color = color.new(labelColor, 0), textcolor = color.white, size = size.large)

//────────────────────────────────────
// BUY PUT ENTRY
//────────────────────────────────────
if firstBuyPut
    float riskMult2 = isMeanReversion ? effRiskATRMultReversal : effRiskATRMult
    
    // 🆕 Apply time-of-day risk adjustment
    riskMult2 := riskMult2 * todRiskMult
    
    float riskDist2 = riskMult2 * atr14

    lastEntryPrice   := close
    lastRiskATR      := riskDist2
    lastDirection    := -1
    barsSinceEntry   := 0
    tp1Triggered     := false
    tp2Triggered     := false
    timeStopTriggered := false

    maxBarsThisTrade := regimeMaxBars
    float rrLocal2 = regimeRRMult

    float putStop   = close + riskDist2
    float putTarget = close - rrLocal2 * riskDist2
    currStopPrice   := putStop
    currTargetPrice := putTarget

    stopLine   := line.new(bar_index, putStop,   bar_index, putStop,   extend = extend.none, color = color.new(color.red,   0), width = 1)
    targetLine := line.new(bar_index, putTarget, bar_index, putTarget, extend = extend.none, color = color.new(color.green, 0), width = 1)

    float oneR_dollar2   = riskDist2 * 100.0
    float contractsF2    = oneR_dollar2 > 0 ? perTradeRiskDollar / oneR_dollar2 : 0.0
    
    // 🆕 Apply 5-layer sizing
    contractsF2 := contractsF2 * sizingMultiplier
    
    int   contractsSize2 = contractsF2 > 0 ? int(math.round(contractsF2)) : 0
    
    if enableScaling and lastSetupType == "REVERSAL"
        contractsSize2 := int(math.round(contractsSize2 * initialPositionPct / 100.0))

    string setupText2 = currentSetupType == "REVERSAL" ? ("Setup: REVERSAL Short (Score " + str.tostring(qualityScore, "#") + ")") : currentSetupType == "WEAK_TREND" ? "Setup: Weak Trend Short" : currentSetupType == "BREAKOUT" ? "Setup: BREAKOUT (early)" : currentSetupType == "SCALP" ? "Setup: Scalp Short" : "Setup: Trend Short"

    string modeText2 = "Regime: " + regimeType + " | Score: " + str.tostring(qualityScore, "#") + "/100"

    string sizeText2 = ideaState == ideaStateOff ? "Size: NONE (campaign off)" : sizingMultiplier >= 0.8 ? "Size: LARGE" : sizingMultiplier >= 0.5 ? "Size: NORMAL" : sizingMultiplier >= 0.3 ? "Size: SMALL" : "Size: PROBE"

    string helperText2 = ""
    if showSizeHelper and oneR_dollar2 > 0
        string qualityText2 = "Mult: " + str.tostring(sizingMultiplier, "#.##") + "x | RR: " + str.tostring(rrLocal2, "#.#") + "R"
        string optionsText2 = "🎯 " + strikeGuidanceNew + " | " + expirationGuidanceNew
        helperText2 := "\n" + modeText2 + "\n" + setupText2 + "\n" + qualityText2 + "\n" + optionsText2 + "\n1R ≈ $" + str.tostring(oneR_dollar2, "#.##") +
                       "\nSize guide: " + str.tostring(contractsSize2) + " contracts"
    else
        helperText2 := "\n" + modeText2 + "\n" + setupText2

    color labelColor2 = currentSetupType == "REVERSAL" ? color.purple : currentSetupType == "BREAKOUT" ? color.blue : color.red
    label.new(bar_index, yBuyPut, "BUY PUT\n" + sizeText2 + helperText2, style = label.style_label_down, color = color.new(labelColor2, 0), textcolor = color.white, size = size.large)

//────────────────────────────────────
// CURRENT R + EXIT MANAGEMENT
//────────────────────────────────────
float currentR = na
if (inCall or inPut) and not na(lastEntryPrice) and lastRiskATR > 0
    float move       = close - lastEntryPrice
    float signedMove = lastDirection == +1 ? move : -move
    currentR := signedMove / lastRiskATR

if (inCall or inPut or firstSellCall or firstSellPut)
    if not na(stopLine)
        line.set_x2(stopLine, bar_index)
    if not na(targetLine)
        line.set_x2(targetLine, bar_index)

if (inCall or inPut) and not na(currentR)
    if not tp1Triggered and currentR >= 1.0
        tp1Triggered := true
        label.new(bar_index, close, "TP1 ~ +1R\nConsider partial", style = (lastDirection == +1 ? label.style_label_down : label.style_label_up), color = color.new(color.yellow, 0), textcolor = color.black, size = size.small)

    if not tp2Triggered and currentR >= 2.0
        tp2Triggered := true
        label.new(bar_index, close, "TP2 ~ +2R\nStart trail / protect", style = (lastDirection == +1 ? label.style_label_down : label.style_label_up), color = color.new(color.orange, 0), textcolor = color.black, size = size.small)

    if tp2Triggered and lastRiskATR > 0 and not na(stopLine)
        float newStopPrice = lastDirection == +1 ?
             math.max(currStopPrice, lastEntryPrice + 1.0 * lastRiskATR) :
             math.min(currStopPrice, lastEntryPrice - 1.0 * lastRiskATR)
        if newStopPrice != currStopPrice
            currStopPrice := newStopPrice
            line.set_y1(stopLine, currStopPrice)
            line.set_y2(stopLine, currStopPrice)

    int maxBars = na(maxBarsThisTrade) ? maxBarsInTradeTrend : maxBarsThisTrade
    if not timeStopTriggered and not na(barsSinceEntry) and barsSinceEntry >= maxBars and math.abs(currentR) < 0.3
        timeStopTriggered := true
        label.new(bar_index, close, "TIME STOP\nNo progress, consider exit", style = (lastDirection == +1 ? label.style_label_down : label.style_label_up), color = color.new(color.gray, 0), textcolor = color.white, size = size.small)

//────────────────────────────────────
// EXIT LABELS
//────────────────────────────────────
if firstSellCall
    float tradeR = 0.0
    if not na(lastEntryPrice) and lastRiskATR > 0
        float moveExit       = close - lastEntryPrice
        float signedMoveExit = +1 * moveExit
        tradeR := signedMoveExit / lastRiskATR

    dayPnL_R    += tradeR
    tradesToday += 1

    if inRTH
        array.push(tradeRsRTH, tradeR)
        if array.size(tradeRsRTH) > statsLookback
            array.shift(tradeRsRTH)
        todayR_RTH     += tradeR
        tradesTodayRTH += 1

    if ideaState != ideaStateOff
        if dayPnL_R >= 1.0 and ideaState == ideaStateProbe
            ideaState := ideaStateCore
        if dayPnL_R >= 3.0 and ideaState == ideaStateCore
            ideaState := ideaStateExpansion

    lastEntryPrice    := na
    lastRiskATR       := na
    lastDirection     := 0
    tp1Triggered      := false
    tp2Triggered      := false
    timeStopTriggered := false
    barsSinceEntry    := na
    maxBarsThisTrade  := na
    lastSetupType     := ""

    stopLine        := na
    targetLine      := na
    currStopPrice   := na
    currTargetPrice := na

    string rTextCall = "R: " + str.tostring(tradeR, "#.##")

    label.new(bar_index, ySellCall, "SELL CALL\n" + rTextCall, style = label.style_label_down, color = color.new(color.green, 10), textcolor = color.black, size = size.large)

if firstSellPut
    float tradeR2 = 0.0
    if not na(lastEntryPrice) and lastRiskATR > 0
        float moveExit2       = lastEntryPrice - close
        float signedMoveExit2 = +1 * moveExit2
        tradeR2 := signedMoveExit2 / lastRiskATR

    dayPnL_R    += tradeR2
    tradesToday += 1

    if inRTH
        array.push(tradeRsRTH, tradeR2)
        if array.size(tradeRsRTH) > statsLookback
            array.shift(tradeRsRTH)
        todayR_RTH     += tradeR2
        tradesTodayRTH += 1

    if ideaState != ideaStateOff
        if dayPnL_R >= 1.0 and ideaState == ideaStateProbe
            ideaState := ideaStateCore
        if dayPnL_R >= 3.0 and ideaState == ideaStateCore
            ideaState := ideaStateExpansion

    lastEntryPrice    := na
    lastRiskATR       := na
    lastDirection     := 0
    tp1Triggered      := false
    tp2Triggered      := false
    timeStopTriggered := false
    barsSinceEntry    := na
    maxBarsThisTrade  := na
    lastSetupType     := ""

    stopLine        := na
    targetLine      := na
    currStopPrice   := na
    currTargetPrice := na

    string rTextPut = "R: " + str.tostring(tradeR2, "#.##")

    label.new(bar_index, ySellPut, "SELL PUT\n" + rTextPut, style = label.style_label_up, color = color.new(color.maroon, 10), textcolor = color.white, size = size.large)

//────────────────────────────────────
// STATS DASHBOARD
//────────────────────────────────────
var table statsTable = table.new(position.top_right, 3, 3, border_width = 1)

if barstate.isnew and showStatsTable
    int totalRTH = array.size(tradeRsRTH)
    float sumR   = 0.0
    int   wins   = 0
    float avgR   = 0.0
    float winRate = 0.0

    if totalRTH > 0
        for i = 0 to totalRTH - 1
            float rVal = array.get(tradeRsRTH, i)
            sumR += rVal
            if rVal > 0
                wins += 1
        avgR    := sumR / totalRTH
        winRate := 100.0 * wins / totalRTH

    string hdrTxt  = totalRTH > 0 ? "Last " + str.tostring(totalRTH) + " RTH trades" : "No RTH trades yet"
    string winTxt  = totalRTH > 0 ? "Win%: " + str.tostring(winRate, "#.##") + "%" : ""
    string avgTxt  = totalRTH > 0 ? "Avg R: " + str.tostring(avgR, "#.##") : ""
    string netTxt  = totalRTH > 0 ? "Net R: " + str.tostring(sumR, "#.##") : ""

    string todayHdr = "Today RTH"
    string todayNet = "Net R: " + str.tostring(todayR_RTH, "#.##")
    string todayTr  = "Trades: " + str.tostring(tradesTodayRTH)

    table.cell(statsTable, 0, 0, hdrTxt,  text_color = color.white, bgcolor = color.new(color.black, 0))
    table.cell(statsTable, 0, 1, winTxt,  text_color = color.white, bgcolor = color.new(color.black, 0))
    table.cell(statsTable, 1, 1, avgTxt,  text_color = color.white, bgcolor = color.new(color.black, 0))
    table.cell(statsTable, 2, 1, netTxt,  text_color = color.white, bgcolor = color.new(color.black, 0))

    table.cell(statsTable, 0, 2, todayHdr, text_color = color.white, bgcolor = color.new(color.black, 0))
    table.cell(statsTable, 1, 2, todayNet, text_color = color.white, bgcolor = color.new(color.black, 0))
    table.cell(statsTable, 2, 2, todayTr,  text_color = color.white, bgcolor = color.new(color.black, 0))

//────────────────────────────────────
// TINY MARKERS
//────────────────────────────────────
plotshape(showTinyMarks and buyCall,
     title    = "Buy Call marker",
     style    = shape.triangleup,
     location = location.belowbar,
     size     = size.tiny,
     color    = color.lime)

plotshape(showTinyMarks and sellCall,
     title    = "Sell Call marker",
     style    = shape.triangledown,
     location = location.abovebar,
     size     = size.tiny,
     color    = color.green)

plotshape(showTinyMarks and buyPut,
     title    = "Buy Put marker",
     style    = shape.triangledown,
     location = location.abovebar,
     size     = size.tiny,
     color    = color.red)

plotshape(showTinyMarks and sellPut,
     title    = "Sell Put marker",
     style    = shape.triangleup,
     location = location.belowbar,
     size     = size.tiny,
     color    = color.maroon)

//────────────────────────────────────
// ALERT TRIGGERS
//────────────────────────────────────
bool execBuyCall  = firstBuyCall
bool execSellCall = firstSellCall
bool execBuyPut   = firstBuyPut
bool execSellPut  = firstSellPut

// Classify by setup type
bool execBuyCallTrend     = execBuyCall and currentSetupType == "TREND"
bool execBuyCallScalp     = execBuyCall and currentSetupType == "SCALP"
bool execBuyCallReversal  = execBuyCall and (currentSetupType == "SWING_REJECTION" or currentSetupType == "FAILED_BREAKDOWN")

bool execBuyPutTrend      = execBuyPut and currentSetupType == "TREND"
bool execBuyPutScalp      = execBuyPut and currentSetupType == "SCALP"
bool execBuyPutReversal   = execBuyPut and (currentSetupType == "SWING_REJECTION" or currentSetupType == "FAILED_BREAKDOWN")

bool firstPreBuyCall = preBuyCall and not preBuyCall[1]
bool firstPreBuyPut  = preBuyPut  and not preBuyPut[1]

// Alert messages
string preCallMsg        = "PRE-SIGNAL BUY CALL setup on {{ticker}} {{interval}}. Do NOT enter yet. Get 0DTE/1DTE CALL chain ready."
string prePutMsg         = "PRE-SIGNAL BUY PUT setup on {{ticker}} {{interval}}. Do NOT enter yet. Get 0DTE/1DTE PUT chain ready."
string execCallTrendMsg  = "EXECUTE BUY CALL (TREND MODE) on {{ticker}} {{interval}}. Signal confirmed."
string execCallScalpMsg  = "EXECUTE BUY CALL (SCALP MODE) on {{ticker}} {{interval}}. Expect smaller targets."
string execCallRevMsg    = "EXECUTE BUY CALL (REVERSAL) on {{ticker}} {{interval}}. SWING REJECTION or FAILED BREAKDOWN detected. Start with PROBE size."
string execPutTrendMsg   = "EXECUTE BUY PUT (TREND MODE) on {{ticker}} {{interval}}. Signal confirmed."
string execPutScalpMsg   = "EXECUTE BUY PUT (SCALP MODE) on {{ticker}} {{interval}}. Expect smaller targets."
string execPutRevMsg     = "EXECUTE BUY PUT (REVERSAL) on {{ticker}} {{interval}}. SWING REJECTION or FAILED BREAKOUT detected. Start with PROBE size."
string exitCallMsg       = "EXIT CALL / SELL CALL on {{ticker}} {{interval}}."
string exitPutMsg        = "EXIT PUT / SELL PUT on {{ticker}} {{interval}}."

// Alert conditions
alertcondition(firstPreBuyCall,      title = "PRE: BUY CALL setup",      message = preCallMsg)
alertcondition(firstPreBuyPut,       title = "PRE: BUY PUT setup",       message = prePutMsg)

alertcondition(execBuyCallTrend,     title = "EXEC: BUY CALL (TREND)",    message = execCallTrendMsg)
alertcondition(execBuyCallScalp,     title = "EXEC: BUY CALL (SCALP)",    message = execCallScalpMsg)
alertcondition(execBuyCallReversal,  title = "EXEC: BUY CALL (REVERSAL)", message = execCallRevMsg)

alertcondition(execBuyPutTrend,      title = "EXEC: BUY PUT (TREND)",     message = execPutTrendMsg)
alertcondition(execBuyPutScalp,      title = "EXEC: BUY PUT (SCALP)",     message = execPutScalpMsg)
alertcondition(execBuyPutReversal,   title = "EXEC: BUY PUT (REVERSAL)",  message = execPutRevMsg)

alertcondition(execSellCall,         title = "EXEC: SELL CALL",           message = exitCallMsg)
alertcondition(execSellPut,          title = "EXEC: SELL PUT",            message = exitPutMsg)

