# ─────────────────────────────────────────────────────────────
# 0DTE Options Trading Engine — Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy to .env and fill in your values:
#   cp .env.example .env

# ── Alerts ──────────────────────────────────────────────────
# Discord or Slack webhook URL for trade alerts + safety notifications.
# Discord: https://support.discord.com/hc/en-us/articles/228383668
# Slack:   https://api.slack.com/messaging/webhooks
ALERT_WEBHOOK_URL=

# ── IBKR Connection ────────────────────────────────────────
# TWS/Gateway host and port (defaults shown)
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1

# ── Account ────────────────────────────────────────────────
# Account size (used for position sizing and risk limits)
# Small account: $10K (buys options + sells put credit spreads)
# Medium account: $25K+ (full strategy suite)
ACCOUNT_SIZE=10000

# ── Tickers ────────────────────────────────────────────────
# Comma-separated list of tickers to trade
#
# SPX = S&P 500 Index (RECOMMENDED for buying options)
#   ✓ Cash-settled (no assignment risk)
#   ✓ 60/40 tax treatment (Section 1256)
#   ✓ European-style (no early exercise)
#   ✓ 0DTE daily expirations with massive gamma
#   ✓ Deep liquidity, tight spreads at ATM
#
# SPY = S&P 500 ETF (good for selling premium / smaller plays)
# QQQ = Nasdaq 100 ETF (validated profitable for iron condors)
#
TRADE_TICKERS=SPX

# ── Backend API ────────────────────────────────────────────
# Provider settings for the FastAPI backend
BROKER_PROVIDER=mock
# BROKER_PROVIDER=ibkr
EQUITY_DATA_PROVIDER=ibkr
OPTIONS_DATA_PROVIDER=ibkr
LOG_LEVEL=INFO

# ── OpenAI (optional — for LLM explanations endpoint) ─────
OPENAI_API_KEY=
